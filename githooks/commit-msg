#!/bin/sh
# 🔒 Guardia de datos personales (99 §78) sobre el MENSAJE del commit.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
for d in "$HOME"/.nvm/versions/node/*/bin; do [ -d "$d" ] && PATH="$d:$PATH"; done
if ! command -v node >/dev/null 2>&1; then
  echo "⚠️  commit-msg: 'node' no está en PATH → NO se revisó el mensaje (99 §78)."
  exit 0
fi
node scripts/guardia-cedulas.mjs --mensaje "$1" || { echo "❌ COMMIT BLOQUEADO: el mensaje puede llevar una cédula."; exit 1; }
exit 0
