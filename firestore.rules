rules_version = '2';

// ══════════════════════════════════════════════════════════════
// SGM · TRANSPOWER — Reglas Firestore (Fase 16 · schema v2)
// ──────────────────────────────────────────────────────────────
// Cambios respecto a F14:
//   · `transformadores` migra a shape v2: sección `identificacion`,
//     sección `ubicacion`, `estado_servicio` (enum ampliado con
//     'fallado'), `schema_version == 2`. Se mantiene compat con
//     el shape v1 aplanado (proyección v1) para que las vistas
//     legacy sigan funcionando; los `allow create`/`allow update`
//     aceptan payloads que traigan ambos niveles.
//   · Nueva colección `subestaciones`.
//   · Nuevas subcolecciones append-only `transformadores/{id}/
//     placas_historicas` y `transformadores/{id}/historial_hi`.
//   · Las escrituras siguen restringidas a `isAdmin()` mientras
//     F28 (RBAC granular con ámbito geográfico) entra.
//
// Referencia: MO.00418.DE-GAC-AX.01 Ed. 02 — §4.1 (variables), §4.2
// (ponderación HI), §A9 (protocolos).
// ══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers de sesión / rol ──
    function isSignedIn() { return request.auth != null; }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // ADR-079 (TODO-47a, decisión del Ingeniero 2026-09-20: «el administrador
    // soy yo»): el bootstrap legacy /admins es SOLO para el arranque, cuando
    // todavía no hay perfil. Si el usuario YA tiene perfil en /usuarios, su rol
    // sale de ahí y de ningún otro lado → degradar de admin a técnico revoca de
    // verdad. Antes bastaba con estar en /admins y activo, así que un degradado
    // seguía administrando TODO el backend (ADR-052 solo cerró el caso del
    // desactivado). El bootstrap puro (uid en /admins SIN perfil) se conserva:
    // sin él, borrar el perfil del único admin dejaría el proyecto sin nadie.
    function adminsBootstrapValido() {
      return !hasProfile()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isTeamMember() {
      return isSignedIn() && (
        (hasProfile() && profile().activo == true) ||
        adminsBootstrapValido()
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        (hasProfile() && profile().rol == 'admin' && profile().activo == true) ||
        adminsBootstrapValido()
      );
    }

    // ── Helpers de validación de enums v2 ──
    function isTipoActivoValido(v) {
      return v in ['POTENCIA', 'TPT', 'RESPALDO'];
    }
    function isEstadoServicioValido(v) {
      return v in ['operativo', 'mantenimiento', 'fuera_servicio', 'retirado', 'fallado'];
    }
    function isZonaValida(v) {
      return v in ['BOLIVAR', 'ORIENTE', 'OCCIDENTE'];
    }
    function isDeptoValido(v) {
      return v in ['bolivar', 'cordoba', 'sucre', 'cesar', 'magdalena'];
    }
    function isGrupoValido(v) {
      return v == '' || v == null || v in ['G1', 'G2', 'G3'];
    }

    // ── Helpers de validación de enums F38–F39 (suministros) ──
    function isTipoMovimientoValido(v) {
      return v in ['INGRESO', 'EGRESO'];
    }
    function isUnidadValida(v) {
      return v in ['Und', 'Lt', 'Kg', 'Mt', 'Gal', 'Otro'];
    }
    function isEstadoRepuestoValido(v) {
      return v in ['OPERATIVA', 'OBSOLETA', 'N/A'];
    }
    function isTipoCorreccionValido(v) {
      return v in ['matricula', 'tension', 'regulacion', 'stock', 'marca', 'otro'];
    }
    function isCodigoSuministroValido(v) {
      return v is string && v.matches('^S[0-9]{2}$');
    }
    function isCodigoMovimientoValido(v) {
      return v is string && v.matches('^MOV-[0-9]{4}-[0-9]{4}$');
    }
    function isContratoIdValido(v) {
      return v is string && v.matches('^[0-9]{8,14}$');
    }
    // Contratos con nexo a Órdenes E/S (espejo de NEXO_CONTRATOS en
    // assets/js/domain/ordenes_contrato_nexo.js; una prueba de amarre falla si
    // no coinciden). Solo en ellos el equipo registra entregas de órdenes (99 §148).
    function isContratoConNexo(v) {
      return v in ['4125000143'];
    }
    // Acepta docId legacy (id == codigo) y docId multi-contrato
    // ({contrato_id}_{codigo}) introducido en N3-N5. La parte
    // tras el "_" debe ser exactamente el codigo del payload.
    function isSuministroDocId(id, codigo) {
      return id == codigo
          || (id.matches('^[0-9]{8,14}_S[0-9]{2}$') && id.split('_')[1] == codigo);
    }

    // ── /admins/{uid} — legacy bootstrap (F5) ──
    match /admins/{uid} {
      allow read:  if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── /usuarios/{uid} — perfiles (F14) ──
    // F28 extenderá a los 5 roles oficiales (director_proyectos,
    // analista_tx, gestor_contractual, brigadista, auditor_campo).
    // En F16 se mantiene la lista v1 + aceptación del rol legacy
    // 'tecnico' (los perfiles actuales no rompen).
    match /usuarios/{uid} {
      allow get:    if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list:   if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll([
                        'email','rol','activo'
                       ])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.rol in [
                        'admin','tecnico',
                        'director_proyectos','analista_tx',
                        'gestor_contractual','brigadista','auditor_campo'
                       ]
                    && request.resource.data.activo is bool;
      allow update: if isAdmin()
                    && (!('rol' in request.resource.data)
                        || request.resource.data.rol in [
                            'admin','tecnico',
                            'director_proyectos','analista_tx',
                            'gestor_contractual','brigadista','auditor_campo'
                           ])
                    && (!('activo' in request.resource.data)
                        || request.resource.data.activo is bool);
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // ── /subestaciones/{id} (Fase 16) ──
    // La UI dedicada entra en F20. F16 sólo expone CRUD admin
    // para que el importador F17 pueda poblar la colección.
    match /subestaciones/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll([
                        'codigo','nombre','departamento'
                       ])
                    && request.resource.data.codigo is string
                    && request.resource.data.codigo.size() > 0
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0
                    && isDeptoValido(request.resource.data.departamento)
                    && (!('zona' in request.resource.data)
                        || request.resource.data.zona == ''
                        || isZonaValida(request.resource.data.zona));
      allow update: if isAdmin()
                    && (!('departamento' in request.resource.data)
                        || isDeptoValido(request.resource.data.departamento))
                    && (!('zona' in request.resource.data)
                        || request.resource.data.zona == ''
                        || isZonaValida(request.resource.data.zona));
      allow delete: if isAdmin();
    }

    // ── /transformadores/{id} — schema v2 ──
    // Shape aceptado:
    //   schema_version: 2
    //   estado_servicio: enum
    //   identificacion: { codigo, nombre, tipo_activo, uucc?, grupo? }
    //   ubicacion: { departamento, zona?, ... }
    //   placa, electrico, mecanico, refrigeracion, protecciones,
    //   fabricacion, servicio, salud_actual, criticidad
    //
    // Además se permiten campos de proyección v1 en el nivel raíz
    // (codigo, nombre, departamento, estado, ...) para compat con
    // vistas legacy que todavía consultan por ellos. Las rules
    // validan AMBOS niveles como coherentes cuando el payload
    // trae los dos.
    match /transformadores/{id} {

      allow read: if isTeamMember();

      allow create: if isAdmin()
        && request.resource.data.schema_version == 2
        && request.resource.data.keys().hasAll(['identificacion','ubicacion','estado_servicio'])
        && request.resource.data.identificacion.keys().hasAll(['codigo','nombre','tipo_activo'])
        && request.resource.data.identificacion.codigo is string
        && request.resource.data.identificacion.codigo.size() > 0
        && request.resource.data.identificacion.nombre is string
        && request.resource.data.identificacion.nombre.size() > 0
        && isTipoActivoValido(request.resource.data.identificacion.tipo_activo)
        && isGrupoValido(request.resource.data.identificacion.get('grupo', ''))
        && isDeptoValido(request.resource.data.ubicacion.departamento)
        && (!('zona' in request.resource.data.ubicacion)
            || request.resource.data.ubicacion.zona == ''
            || isZonaValida(request.resource.data.ubicacion.zona))
        && isEstadoServicioValido(request.resource.data.estado_servicio)
        // Proyección v1 (si está presente) debe ser consistente.
        && (!('codigo' in request.resource.data)
            || request.resource.data.codigo == request.resource.data.identificacion.codigo)
        && (!('estado' in request.resource.data)
            || request.resource.data.estado == request.resource.data.estado_servicio
            || (request.resource.data.estado_servicio == 'fallado'
                && request.resource.data.estado == 'retirado'))
        // F41 · sub-section repuesto opcional. Si está, valida enum.
        && (!('repuesto' in request.resource.data)
            || !('estado' in request.resource.data.repuesto)
            || isEstadoRepuestoValido(request.resource.data.repuesto.estado));

      allow update: if isAdmin()
        && (!('schema_version' in request.resource.data)
            || request.resource.data.schema_version == 2)
        && (!('estado_servicio' in request.resource.data)
            || isEstadoServicioValido(request.resource.data.estado_servicio))
        && (!('identificacion' in request.resource.data)
            || !('tipo_activo' in request.resource.data.identificacion)
            || isTipoActivoValido(request.resource.data.identificacion.tipo_activo))
        && (!('identificacion' in request.resource.data)
            || !('grupo' in request.resource.data.identificacion)
            || isGrupoValido(request.resource.data.identificacion.grupo))
        && (!('ubicacion' in request.resource.data)
            || !('departamento' in request.resource.data.ubicacion)
            || isDeptoValido(request.resource.data.ubicacion.departamento))
        && (!('ubicacion' in request.resource.data)
            || !('zona' in request.resource.data.ubicacion)
            || request.resource.data.ubicacion.zona == ''
            || isZonaValida(request.resource.data.ubicacion.zona))
        // F41 · sub-section repuesto opcional. Si está, valida enum.
        && (!('repuesto' in request.resource.data)
            || !('estado' in request.resource.data.repuesto)
            || isEstadoRepuestoValido(request.resource.data.repuesto.estado));

      allow delete: if isAdmin();

      // ── /transformadores/{id}/placas_historicas/{evt} ──
      // Append-only: trazabilidad de retrofits. F16 reserva el
      // shape; la UI para registrar cambios entra en F23.
      match /placas_historicas/{evt} {
        allow read:   if isTeamMember();
        allow create: if isAdmin()
                      && request.resource.data.tipo_cambio in [
                          'potencia','tension','refrigeracion','tap','otro'
                         ];
        allow update: if false;
        allow delete: if false;
      }

      // ── /transformadores/{id}/historial_hi/{calculo} ──
      // Append-only: snapshots del Health Index. Cada re-cálculo
      // del motor (F18) o cambio de umbrales genera una entrada.
      match /historial_hi/{calculo} {
        allow read:   if isTeamMember();
        allow create: if isAdmin()
                      && request.resource.data.trigger in [
                          'muestra_nueva','parametros_actualizados',
                          'migracion_v2','manual','override_experto',
                          'recalculo_masivo'
                         ];
        allow update: if false;
        allow delete: if false;
      }

      // ── /transformadores/{id}/historial/{evt} (legacy de F7) ──
      // Se mantiene por compat con órdenes viejas. El mismo alias
      // de subcolección no existe; este match es defensivo.
      match /historial/{evt} {
        allow read:   if isTeamMember();
        allow create: if isAdmin();
        allow update: if false;
        allow delete: if false;
      }
    }

    // ── /ordenes/{id} (sin cambios en F16, migra en F23) ──
    match /ordenes/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll([
                        'codigo','titulo','transformadorId',
                        'estado','tipo','prioridad'
                       ])
                    && request.resource.data.codigo is string
                    && request.resource.data.codigo.size() > 0
                    && request.resource.data.estado in [
                        'planificada','en_curso','cerrada','cancelada'
                       ]
                    && request.resource.data.tipo in [
                        'preventivo','correctivo','predictivo','emergencia',
                        'etu','reemplazo','retiro'
                       ]
                    && request.resource.data.prioridad in [
                        'baja','media','alta','critica'
                       ]
                    // v2: si estado_v2 viene, debe ser válido (F23)
                    && (!('estado_v2' in request.resource.data)
                        || request.resource.data.estado_v2 in [
                            'borrador','propuesta','revisada','autorizada',
                            'programada','en_ejecucion','ejecutada','verificada',
                            'cerrada','rechazada','cancelada'
                           ]);
      allow update: if isAdmin()
                    && request.resource.data.estado in [
                        'planificada','en_curso','cerrada','cancelada'
                       ]
                    && request.resource.data.tipo in [
                        'preventivo','correctivo','predictivo','emergencia',
                        'etu','reemplazo','retiro'
                       ]
                    && request.resource.data.prioridad in [
                        'baja','media','alta','critica'
                       ]
                    && (!('estado_v2' in request.resource.data)
                        || request.resource.data.estado_v2 in [
                            'borrador','propuesta','revisada','autorizada',
                            'programada','en_ejecucion','ejecutada','verificada',
                            'cerrada','rechazada','cancelada'
                           ]);
      allow delete: if isAdmin();

      match /historial/{evt} {
        allow read:   if isTeamMember();
        allow create: if isAdmin();
        allow update: if false;
        allow delete: if false;
      }
    }

    // ── /documentos/{id} (sin cambios en F16) ──
    match /documentos/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll([
                        'codigo','titulo','categoria','norma_aplicable'
                       ])
                    && request.resource.data.codigo is string
                    && request.resource.data.codigo.size() > 0
                    && request.resource.data.categoria in [
                        'protocolo','informe','certificado','manual','reporte','otro'
                       ]
                    && request.resource.data.norma_aplicable in [
                        'ISO_50001','IEEE_C57_12','IEC_60076',
                        'RETIE','NTC_IEC_60364','CIGRE_WG_A2','NINGUNA'
                       ];
      allow update: if isAdmin()
                    && request.resource.data.categoria in [
                        'protocolo','informe','certificado','manual','reporte','otro'
                       ]
                    && request.resource.data.norma_aplicable in [
                        'ISO_50001','IEEE_C57_12','IEC_60076',
                        'RETIE','NTC_IEC_60364','CIGRE_WG_A2','NINGUNA'
                       ];
      allow delete: if isAdmin();
    }

    match /alertas_config/{id} {
      allow read:   if isTeamMember();
      allow write:  if isAdmin();
    }

    // ── /umbrales_salud/{id} (Fase 18) ──
    // Documento `global` con los umbrales activos del motor de
    // salud. Historial append-only en /historial/{id}.
    match /umbrales_salud/{id} {
      allow read:   if isTeamMember();
      allow write:  if isAdmin();
      match /historial/{evt} {
        allow read:   if isTeamMember();
        allow create: if isAdmin();
        allow update: if false;
        allow delete: if false;
      }
    }

    // ── /contramuestras/{id} (F26) ──
    match /contramuestras/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── /monitoreo_intensivo/{id} (F18/F26 · A9.1) ──
    match /monitoreo_intensivo/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.transformadorId is string
                    && request.resource.data.tipo == 'C2H2';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── /auditoria/{id} (F35) ──
    match /auditoria/{id} {
      allow read:   if isAdmin() || (hasProfile() && profile().rol == 'auditor_campo');
      // G002 (ADR-052 Ola 1): antes cualquier autenticado (incl. desactivado)
      // podía escribir el log. Ahora exige miembro ACTIVO. append-only intacto.
      allow create: if isTeamMember()
                    && request.resource.data.accion is string;
      allow update: if false;
      allow delete: if false;
    }

    // ── /fallados/{id} (F25) ──
    match /fallados/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.transformadorId is string
                    && request.resource.data.tipo_falla in
                       ['termica','electrica','mecanica','quimica','externa','desconocida']
                    && request.resource.data.metodo_rca in
                       ['5_porques','ishikawa','fmea'];
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── /parametros_sistema/{id} (F36) ──
    match /parametros_sistema/{id} {
      allow read:   if isTeamMember();
      allow write:  if isAdmin();
    }

    // ── /contratos/{id} (F21) ──
    match /contratos/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.codigo is string
                    && request.resource.data.codigo.size() > 0
                    && request.resource.data.estado in
                       ['vigente','suspendido','finalizado','en_liquidacion'];
      allow update: if isAdmin()
                    && request.resource.data.estado in
                       ['vigente','suspendido','finalizado','en_liquidacion'];
      allow delete: if isAdmin();
    }

    // ── /subactividades, /macroactividades, /causantes (F22) ──
    match /subactividades/{id} {
      allow read:   if isTeamMember();
      allow write:  if isAdmin();
    }
    match /macroactividades/{id} {
      allow read:   if isTeamMember();
      allow write:  if isAdmin();
    }
    match /causantes/{id} {
      allow read:   if isTeamMember();
      allow write:  if isAdmin();
    }

    // ── /muestras/{id} (Fase 19) ──
    // Time-series DGA/ADFQ/FUR. Read team, Create/Update admin
    // con validación de enum tipo. Delete solo admin.
    match /muestras/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.transformadorId is string
                    && request.resource.data.tipo in ['DGA','ADFQ','FURANOS','COMBO']
                    && request.resource.data.fecha_muestra is string;
      allow update: if isAdmin()
                    && (!('tipo' in request.resource.data)
                        || request.resource.data.tipo in ['DGA','ADFQ','FURANOS','COMBO']);
      allow delete: if isAdmin();
    }

    // ── /importaciones/{id} (Fase 17) ──
    // Log append-only de jobs de importación Excel. Cada job
    // lleva el reporte de discrepancias Excel ↔ MO.00418.
    match /importaciones/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // ── /propuestas_reclasificacion_fur/{id} (F18/F26 · A9.2) ──
    match /propuestas_reclasificacion_fur/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.transformadorId is string
                    && request.resource.data.estado == 'pendiente_revision_experto'
                    && request.resource.data.referencia_normativa is string;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /alertas_reconocidas/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.alertId is string
                    && request.resource.data.alertId.size() > 0;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Gate legacy F12 cerrado ──
    match /gate_codes/{hash} {
      allow read, write: if false;
    }

    // ══════════════════════════════════════════════════════════
    // F40 · Suministros / Repuestos / Stock
    // ══════════════════════════════════════════════════════════

    // ── /suministros/{id} ──
    // docId acepta dos formas (decisión N3-N5):
    //   · legacy:        id == codigo                  (1 contrato)
    //   · multi-contrato: id == "{contrato_id}_{codigo}" (N contratos)
    // En ambos casos la parte humana (codigo) es Sxx.
    match /suministros/{id} {
      allow read: if isTeamMember();
      allow create: if isAdmin()
                    && isCodigoSuministroValido(request.resource.data.codigo)
                    && isSuministroDocId(id, request.resource.data.codigo)
                    && (!('contrato_id' in request.resource.data)
                        || request.resource.data.contrato_id == ''
                        || isContratoIdValido(request.resource.data.contrato_id))
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0
                    && isUnidadValida(request.resource.data.unidad)
                    && request.resource.data.stock_inicial is number
                    && request.resource.data.stock_inicial >= 0
                    && request.resource.data.valor_unitario is number
                    && request.resource.data.valor_unitario >= 0;
      allow update: if isAdmin()
                    // Codigo es inmutable (PK humana).
                    && (!('codigo' in request.resource.data)
                        || request.resource.data.codigo == resource.data.codigo)
                    && (!('unidad' in request.resource.data)
                        || isUnidadValida(request.resource.data.unidad))
                    && (!('stock_inicial' in request.resource.data)
                        || (request.resource.data.stock_inicial is number
                            && request.resource.data.stock_inicial >= 0));
      allow delete: if isAdmin();
    }

    // ── /marcas/{id} ──
    // docId auto-generado (collection().doc()). contrato_id opcional
    // (legacy) o presente (N3-N5 multi-contrato).
    match /marcas/{id} {
      allow read: if isTeamMember();
      allow create: if isAdmin()
                    && isCodigoSuministroValido(request.resource.data.suministro_id)
                    && (!('contrato_id' in request.resource.data)
                        || request.resource.data.contrato_id == ''
                        || isContratoIdValido(request.resource.data.contrato_id))
                    && request.resource.data.marca is string
                    && request.resource.data.marca.size() > 0;
      allow update: if isAdmin()
                    && (!('suministro_id' in request.resource.data)
                        || isCodigoSuministroValido(request.resource.data.suministro_id))
                    && (!('marca' in request.resource.data)
                        || (request.resource.data.marca is string
                            && request.resource.data.marca.size() > 0));
      allow delete: if isAdmin();
    }

    // ── /movimientos/{id} ──
    // Decisión 6·A del plan: WRITE solo admin. Tecnico/brigadista no
    // crean movimientos. La aplicación cliente envuelve crear() en
    // runTransaction (F39); aquí validamos invariantes server-side.
    // EXCEPCIÓN (99 §148, decisión del Ingeniero «permitirles registrar»): el
    // equipo registra y corrige SOLO los egresos ENLAZADOS a una orden de
    // ENTRADA de un contrato con nexo: id fijo «oes_<contrato>_<orden>_<Sxx>»,
    // la orden existe tal como se leyó (versión), valor del catálogo y
    // consecutivo MOV tomado del contador en la misma transacción. Retirar uno
    // solo vale si la orden ya no lo respalda. Lo demás sigue siendo del admin.
    match /movimientos/{id} {
      function movCamposValidos(d) {
        return isCodigoMovimientoValido(d.codigo)
          && isTipoMovimientoValido(d.tipo)
          && isCodigoSuministroValido(d.suministro_id)
          && (!('contrato_id' in d) || d.contrato_id == '' || isContratoIdValido(d.contrato_id))
          && d.cantidad is int
          && d.cantidad >= 1
          && d.transformador_id is string
          && d.transformador_id.size() > 0
          && d.matricula is string
          && d.matricula.size() > 0
          && d.anio is int
          && d.anio >= 2000
          && d.anio <= 2100
          && d.valor_total is number
          && d.valor_total >= 0;
      }
      function movOrdenRuta(clave) {
        return /databases/$(database)/documents/ordenes_materiales/$(clave);
      }
      function movEsDeOrden(d) {
        return d.get('orden_es', null) is map
          && d.orden_es.get('clave', '') is string
          && d.orden_es.clave.size() > 0
          && isContratoConNexo(d.get('contrato_id', ''))
          && id == 'oes_' + d.contrato_id + '_' + d.orden_es.clave + '_' + d.suministro_id;
      }
      function movOrdenLoRespalda(d) {
        let o = get(movOrdenRuta(d.orden_es.clave)).data;
        return o.tipo == 'ENTRADA'
          && o.fechaISO == d.orden_es.get('fechaISO', '')
          && o.version == d.orden_es.get('version', -1);
      }
      function movOrdenYaNoLoRespalda(d) {
        let ruta = movOrdenRuta(d.orden_es.clave);
        return !exists(ruta)
          || get(ruta).data.tipo != 'ENTRADA'
          || get(ruta).data.fechaISO != d.orden_es.get('fechaISO', '')
          || get(ruta).data.get('transformador', '').trim() != d.orden_es.get('transformador', '')
          // El SDK web guarda la creación en ms CON la fracción de los microsegundos; toMillis() de la
          // regla es entero: se recorta antes de comparar (si no, siempre daría «distinto»).
          || (get(ruta).data.creadoEn is timestamp
              && get(ruta).data.creadoEn.toMillis() != math.floor(d.orden_es.get('creadoEn', 0)))
          || ('version' in d.orden_es && get(ruta).data.version != d.orden_es.version);
      }
      function movValorDelCatalogo(d) {
        return d.valor_unitario == get(/databases/$(database)/documents/suministros/$(d.contrato_id + '_' + d.suministro_id)).data.valor_unitario
          && d.valor_total == d.cantidad * d.valor_unitario;
      }
      // El código es el valor NUEVO del contador, que avanza de a uno en esta misma escritura
      // (sin tocar el contador no se puede reutilizar un MOV ya asignado) y su año es el del movimiento.
      function movContadorRuta(d) {
        return /databases/$(database)/documents/suministros_config/$('correlativo_mov_' + string(d.anio));
      }
      function movConsumeElContador(d) {
        let c = movContadorRuta(d);
        let n = getAfter(c).data.ultimo;
        return d.codigo.split('-')[1] == string(d.anio)
          && int(d.codigo.split('-')[2]) == n
          && n == (exists(c) ? get(c).data.ultimo + 1 : 1);
      }

      allow read: if isTeamMember();
      allow create: if isAdmin() && movCamposValidos(request.resource.data);
      allow create: if isTeamMember()
                    && movCamposValidos(request.resource.data)
                    && request.resource.data.tipo == 'EGRESO'
                    && movEsDeOrden(request.resource.data)
                    && exists(movOrdenRuta(request.resource.data.orden_es.clave))
                    && movOrdenLoRespalda(request.resource.data)
                    && movValorDelCatalogo(request.resource.data)
                    && movConsumeElContador(request.resource.data)
                    && request.resource.data.createdBy == request.auth.uid;
      // Update permitido solo para corregir typos de campos no críticos
      // (observaciones, odt). Codigo, tipo, cantidad, suministro_id,
      // transformador_id NO se pueden cambiar — para corregir un
      // movimiento se elimina (con justificación) y se crea otro.
      allow update: if isAdmin()
                    && request.resource.data.codigo == resource.data.codigo
                    && request.resource.data.tipo == resource.data.tipo
                    && request.resource.data.cantidad == resource.data.cantidad
                    && request.resource.data.suministro_id == resource.data.suministro_id
                    && request.resource.data.transformador_id == resource.data.transformador_id;
      allow delete: if isAdmin();
      allow delete: if isTeamMember()
                    && movEsDeOrden(resource.data)
                    && movOrdenYaNoLoRespalda(resource.data);
    }

    // ── /correcciones/{id} ──
    // Append + update permitidos. Delete BLOQUEADO (traceability
    // inmutable, regla del skill asset-tracking-system).
    match /correcciones/{id} {
      allow read: if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.numero is int
                    && request.resource.data.numero >= 1
                    && isTipoCorreccionValido(request.resource.data.tipo)
                    && (!('contrato_id' in request.resource.data)
                        || request.resource.data.contrato_id == ''
                        || isContratoIdValido(request.resource.data.contrato_id))
                    && request.resource.data.ubicacion is string
                    && request.resource.data.ubicacion.size() > 0
                    && request.resource.data.justificacion is string
                    && request.resource.data.justificacion.size() > 0;
      allow update: if isAdmin()
                    && (!('tipo' in request.resource.data)
                        || isTipoCorreccionValido(request.resource.data.tipo));
      allow delete: if false;
    }

    // ── /suministros_config/{id} ──
    // Singleton /suministros_config/global con permitirNegativo y umbrales.
    match /suministros_config/{id} {
      // Contador del consecutivo MOV por año (99 §147/§148): el equipo lo avanza
      // DE A UNO al registrar una entrega de una orden (la regla del movimiento
      // exige que su código sea el valor nuevo del contador en la misma transacción).
      function contadorMovValido(d) {
        return id.matches('^correlativo_mov_[0-9]{4}$')
          && d.keys().hasOnly(['anio', 'ultimo', 'updatedAt'])
          && d.anio is int
          && id == 'correlativo_mov_' + string(d.anio)
          && d.ultimo is int
          && d.updatedAt == request.time;
      }
      allow read: if isTeamMember();
      allow write: if isAdmin();
      allow create: if isTeamMember()
                    && contadorMovValido(request.resource.data)
                    && request.resource.data.ultimo == 1;
      allow update: if isTeamMember()
                    && contadorMovValido(request.resource.data)
                    && request.resource.data.anio == resource.data.anio
                    && request.resource.data.ultimo == resource.data.ultimo + 1;
    }

    // ── /acciones_refrigeracion/{id} ──
    // Acciones de mantenimiento del sistema de refrigeración
    // generadas desde el módulo Mantenimiento Brigada (Selección
    // ONAF · mix multi-modelo). Cada documento es un snapshot
    // completo del cálculo + datos del responsable + estado del
    // workflow. Lectura por todo el equipo; creación / update /
    // delete por admin (los brigadistas envían la acción al admin
    // para registro en una sesión posterior). El transformador
    // referenciado no se puede cambiar después de creado el doc.
    match /acciones_refrigeracion/{id} {
      allow read: if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.transformador_id is string
                    && request.resource.data.transformador_id.size() > 0
                    && request.resource.data.matricula is string
                    && request.resource.data.matricula.size() > 0
                    && request.resource.data.accion_descripcion is string
                    && request.resource.data.accion_descripcion.size() >= 10
                    && request.resource.data.estado_accion in
                       ['planificada', 'pendiente_aprobacion', 'aprobada', 'ejecutada', 'cancelada']
                    && request.resource.data.mix is list
                    && request.resource.data.mix.size() >= 1
                    && request.resource.data.fecha_accion is string
                    && request.resource.data.fecha_accion.size() > 0;
      allow update: if isAdmin()
                    && (!('estado_accion' in request.resource.data)
                        || request.resource.data.estado_accion in
                           ['planificada', 'pendiente_aprobacion', 'aprobada', 'ejecutada', 'cancelada'])
                    && request.resource.data.transformador_id == resource.data.transformador_id;
      allow delete: if isAdmin();
    }

    // ── Pruebas Eléctricas (Mantenimiento Predictivo) ──
    // Unidad = transformador con su ficha de identidad; subcolección
    // `informes` = un doc por año/ensayo con el resumen escalar de cada
    // prueba (tand[] + excitacion/relacion/resistencia/aislamiento/collar)
    // y el PDF original en Storage. Lectura para el equipo, escritura admin.
    match /pruebas_electricas/{id} {
      allow read: if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.serie is string
                    && request.resource.data.serie.size() > 0;
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /informes/{informeId} {
        allow read: if isTeamMember();
        allow create: if isAdmin()
                      && request.resource.data.ano is number;
        allow update: if isAdmin();
        allow delete: if isAdmin();

        // Diagnóstico de extracción (ADR-007): bloques + interpretación cruda
        // de la IA. Subcolección perezosa (no se lee en la suscripción viva).
        // Las reglas NO cascadean → match explícito. Lectura para el equipo,
        // escritura solo admin.
        match /diagnostico/{d} {
          allow read: if isTeamMember();
          allow create, update: if isAdmin();
          allow delete: if isAdmin();
        }
      }
    }

    // ── Órdenes de Materiales: registro del equipo de OE/OS (99 §77) ──
    // La PRIMERA colección donde escribe un técnico (decisión del Ingeniero:
    // guardan y editan todos los miembros activos; borra quien la creó o un
    // admin). Espejo de `assets/js/domain/ordenes_registro.js` (LIMITES,
    // RE_NUMERO): si cambian allá, cambian aquí y en tests-rules/.
    //  · la clave SALE del tipo y el número: nadie guarda dos veces la misma
    //    orden ni esconde una orden bajo la clave de otra;
    //  · personas SOLO con nombre (sin cédulas); autoría = quien escribe, con
    //    el nombre de su perfil; sellos del servidor; versión +1 al editar;
    //  · borrar exige dejar en la MISMA escritura la lápida con la copia
    //    exacta de lo borrado (recuperación, y freno a que una copia vieja de
    //    un navegador la resucite);
    //  · límite: el INTERIOR de cada ítem no se valida aquí (las reglas no
    //    recorren listas); lo limpia el cliente.
    match /ordenes_materiales/{clave} {
      function omTexto(d, k, max) {
        return !(k in d) || (d[k] is string && d[k].size() <= max);
      }
      function omPersona(p) {
        return p is map && p.keys().hasOnly(['nombre'])
          && p.get('nombre', '') is string && p.get('nombre', '').size() <= 120;
      }
      function omAutor(a) {
        return a is map && a.keys().hasOnly(['uid', 'nombre'])
          && a.uid == request.auth.uid
          && a.nombre == profile().get('nombre', '');
      }
      function omValida(d) {
        return d.keys().hasOnly(['clave', 'tipo', 'numero', 'zona', 'fechaISO', 'fecha', 'hora',
                                 'origen', 'destino', 'items', 'transformador', 'motivo', 'motivoSel',
                                 'nota', 'autorizado', 'entregado', 'recibido', 'empresaVig',
                                 'conFirmas', 'creadoPor', 'creadoEn', 'actualizadoPor',
                                 'actualizadoEn', 'version', 'migradaDe', 'elaboradaEn'])
          && d.keys().hasAll(['clave', 'tipo', 'numero', 'fechaISO', 'items', 'autorizado',
                              'entregado', 'recibido', 'creadoPor', 'creadoEn', 'actualizadoPor',
                              'actualizadoEn', 'version'])
          && d.tipo in ['ENTRADA', 'SALIDA']
          && d.numero is string && d.numero.matches('^[A-Z0-9][A-Z0-9 ._/-]{0,29}$')
          && d.clave == clave
          && clave == d.tipo + '_' + d.numero.replace('/', '~')
          && d.fechaISO is string && d.fechaISO.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.items is list && d.items.size() >= 1 && d.items.size() <= 200
          && omPersona(d.autorizado) && omPersona(d.entregado) && omPersona(d.recibido)
          && omTexto(d, 'zona', 60) && omTexto(d, 'fecha', 60) && omTexto(d, 'hora', 20)
          && omTexto(d, 'origen', 160) && omTexto(d, 'destino', 160)
          && omTexto(d, 'transformador', 200) && omTexto(d, 'motivo', 500)
          && omTexto(d, 'motivoSel', 500) && omTexto(d, 'nota', 500)
          && omTexto(d, 'empresaVig', 100) && omTexto(d, 'elaboradaEn', 40)
          && (!('conFirmas' in d) || d.conFirmas is bool)
          && (!('migradaDe' in d) || d.migradaDe in ['navegador', 'pendiente'])
          && d.version is int
          && omAutor(d.actualizadoPor) && d.actualizadoEn == request.time;
      }
      function omLapida() {
        return /databases/$(database)/documents/ordenes_materiales_borradas/$(clave);
      }

      allow get:    if isTeamMember();
      allow list:   if isTeamMember() && request.query.limit <= 501;
      allow create: if isTeamMember() && hasProfile()
                    && omValida(request.resource.data)
                    && omAutor(request.resource.data.creadoPor)
                    && request.resource.data.creadoEn == request.time
                    && request.resource.data.version == 1;
      allow update: if isTeamMember() && hasProfile()
                    && omValida(request.resource.data)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['clave', 'tipo', 'numero', 'creadoPor', 'creadoEn',
                                  'migradaDe', 'elaboradaEn'])
                    && request.resource.data.version == resource.data.version + 1;
      allow delete: if isTeamMember() && hasProfile()
                    && (isAdmin() || resource.data.creadoPor.uid == request.auth.uid)
                    && existsAfter(omLapida())
                    && getAfter(omLapida()).data.borradaEn == request.time;
    }

    // Lápida de una orden borrada: solo nace en la MISMA escritura que borra la
    // orden, la escribe quien puede borrarla y guarda la copia EXACTA.
    match /ordenes_materiales_borradas/{clave} {
      function omOrden() {
        return /databases/$(database)/documents/ordenes_materiales/$(clave);
      }
      allow get:    if isTeamMember();
      allow list:   if false;
      allow create, update: if isTeamMember() && hasProfile()
                    && exists(omOrden()) && !existsAfter(omOrden())
                    && (isAdmin() || get(omOrden()).data.creadoPor.uid == request.auth.uid)
                    && request.resource.data.keys().hasOnly(['clave', 'borradaPor', 'borradaEn', 'orden'])
                    && request.resource.data.clave == clave
                    && request.resource.data.borradaPor is map
                    && request.resource.data.borradaPor.keys().hasOnly(['uid', 'nombre'])
                    && request.resource.data.borradaPor.uid == request.auth.uid
                    && request.resource.data.borradaPor.nombre == profile().get('nombre', '')
                    && request.resource.data.borradaEn == request.time
                    && request.resource.data.orden == get(omOrden()).data;
      allow delete: if false;
    }

    // ── Cédulas de los responsables de las Órdenes de Materiales (99 §78) ──
    // El repositorio es público: las cédulas no pueden ir en el código. Aquí
    // las lee el equipo activo UNA a UNA (get por nombre, al generar el
    // documento); listar el directorio completo y escribir, solo el admin.
    // El id sale del nombre (todos los espacios → «_», Ñ incluida) y la
    // escritura exige declarar la autorización de la persona (Ley 1581).
    // Espejo de `assets/js/domain/responsables_ordenes.js`.
    // ── Firmas del EQUIPO · registros que SOLO se agregan (ADR-099) ──
    // Trazabilidad interna elegida por el Ingeniero: nadie edita ni borra.
    //   · firmas_equipo_registro: alta / reemplazo / retiro de cada firma, con la
    //     autorización declarada y la huella de la imagen.
    //   · fichas_emisiones: cada Excel emitido con firmas del equipo: equipo,
    //     casillas con su origen y huella, y la huella del archivo.
    function personaDelEquipo(p) {
      return p in ['MIGUEL_JIMENEZ', 'CARLOS_MARTELO', 'JORGE_RHENALS', 'JORGE_MIRANDA', 'ERICK_VERGARA'];
    }

    // ── Firmas: la IMAGEN vive en Firestore (ADR-100) ──
    // Storage sube pero niega toda descarga desde el navegador (503 en
    // producción, `99 §100`). La imagen PNG va dentro del documento (bytes).
    //   · firmas/{uid}: la firma PROPIA (ADR-071): solo su dueño la lee y la
    //     escribe; nadie lista. Tope 900 KB (cabe en un documento de 1 MiB).
    match /firmas/{uid} {
      allow get:    if isTeamMember() && request.auth.uid == uid;
      allow create, update: if isTeamMember() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['imagen', 'huella', 'en'])
                    && request.resource.data.imagen is bytes
                    && request.resource.data.imagen.size() <= 900 * 1024
                    && request.resource.data.huella is string
                    && request.resource.data.huella.matches('^[0-9a-f]{64}$')
                    && request.resource.data.en == request.time;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }
    //   · firmas_equipo/{custodio}/personas/{persona}: firmas del EQUIPO bajo
    //     custodia (ADR-099): solo SU custodio (admin con perfil). Toda firma se
    //     escribe JUNTO con un registro NUEVO de alta o reemplazo que coincide con
    //     ella (persona, huella y autorización): sin registro no hay firma.
    function firmaConSuRegistroNuevo(persona) {
      let ruta = /databases/$(database)/documents/firmas_equipo_registro/$(request.resource.data.registro);
      let reg = getAfter(ruta).data;
      return !exists(ruta) && existsAfter(ruta)
        && reg.tipo == (resource == null ? 'alta' : 'reemplazo')
        && reg.persona == persona
        && reg.custodio == request.auth.uid
        && reg.huella == request.resource.data.huella
        && reg.autorizacion == request.resource.data.autorizacion;
    }
    // ── Firmas DELEGADAS para Órdenes E/S (ADR-117, decisión del Ingeniero 2026-09-28) ──
    // «que los usuarios de Carlos Martelo y Jorge Rhenals, al exportar la orden, salgan
    // las firmas de ellos y la mía; yo autorizo». El CUSTODIO otorga a un usuario (su
    // uid es el id del documento) que lea del SU directorio solo las personas que
    // nombra, con la autorización de cada titular; todo cambio va con un registro que
    // SOLO se agrega (id determinista). La regla decide quién LEE la imagen: dónde se
    // estampa y el folio de cada emisión los hace cumplir la página (riesgo aceptado).
    function rutaDeleg(u) { return /databases/$(database)/documents/firmas_delegados/$(u); }
    function rutaRegDeleg(id) { return /databases/$(database)/documents/firmas_delegados_registro/$(id); }
    function delegables() { return ['MIGUEL_JIMENEZ', 'CARLOS_MARTELO', 'JORGE_RHENALS']; }
    function autorizacionOk(a) {
      return a is map && a.keys().hasOnly(['fecha', 'medio']) && a.keys().hasAll(['fecha', 'medio'])
        && a.fecha is string && a.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && a.medio is string && a.medio.size() >= 3 && a.medio.size() <= 200;
    }
    function custodioVigente(c) {
      let p = get(/databases/$(database)/documents/usuarios/$(c)).data;
      return p.get('rol', '') == 'admin' && p.get('activo', false) == true;
    }
    // La delegación `d` de quien pide, vigente para el directorio del custodio `c`.
    function delegacionVigente(d, c) {
      return request.auth.uid != c && hasProfile() && profile().get('activo', false) == true
        && d.custodio == c && d.alcance == 'ordenes' && custodioVigente(c);
    }
    function delegadoLee(c, persona) {
      let ruta = rutaDeleg(request.auth.uid);
      return persona in delegables() && exists(ruta)
        && delegacionVigente(get(ruta).data, c) && persona in get(ruta).data.personas;
    }
    // ── Firmas DELEGADAS para Fichas Técnicas (ADR-119, decisión del Ingeniero 2026-09-30) ──
    // «que en el módulo de fichas técnicas Jorge y Carlos puedan exportar el archivo Excel
    // con todas las firmas; yo lo autorizo». Espejo de Órdenes E/S (ADR-117) en colecciones
    // PROPIAS (`firmas_delegados_fichas` + su registro): las cinco personas de la lista, cada
    // una con la autorización de su titular. La regla decide quién LEE la imagen y qué folio
    // vale; dónde se estampa lo hace cumplir la página (riesgo aceptado, como en ADR-117).
    function rutaDelegF(u) { return /databases/$(database)/documents/firmas_delegados_fichas/$(u); }
    function rutaRegDelegF(id) { return /databases/$(database)/documents/firmas_delegados_fichas_registro/$(id); }
    function delegablesFichas() { return ['MIGUEL_JIMENEZ', 'CARLOS_MARTELO', 'JORGE_RHENALS', 'JORGE_MIRANDA', 'ERICK_VERGARA']; }
    // Quién cabe en cada casilla del PE.02081, como UNA expresión regular sobre «casilla|persona»:
    // espejo de FIRMANTES (assets/js/domain/fichas_firmantes.js, `personasPorCasilla`); una prueba
    // compara las dos. Una sola expresión: el servidor evalúa a lo sumo 1000 por petición.
    function firmanteCabe(k, persona) {
      return (k + '|' + persona).matches('^(elab[|](MIGUEL_JIMENEZ|CARLOS_MARTELO|JORGE_RHENALS)|rev[|](JORGE_MIRANDA|MIGUEL_JIMENEZ)|apr[|](JORGE_MIRANDA|ERICK_VERGARA)|apr2[|](ERICK_VERGARA|JORGE_MIRANDA)|rec[|](ERICK_VERGARA))$');
    }
    function delegacionFichasVigente(d, c) {
      return request.auth.uid != c && hasProfile() && profile().get('activo', false) == true
        && d.custodio == c && d.alcance == 'fichas' && custodioVigente(c);
    }
    function delegadoFichasLee(c, persona) {
      let ruta = rutaDelegF(request.auth.uid);
      return persona in delegablesFichas() && exists(ruta)
        && delegacionFichasVigente(get(ruta).data, c) && persona in get(ruta).data.personas;
    }
    match /firmas_equipo/{custodio}/personas/{persona} {
      allow get:    if (request.auth.uid == custodio && hasProfile() && isAdmin() && personaDelEquipo(persona))
                    || delegadoLee(custodio, persona)
                    || delegadoFichasLee(custodio, persona);
      allow create, update: if hasProfile() && isAdmin() && request.auth.uid == custodio && personaDelEquipo(persona)
                    && request.resource.data.keys().hasOnly(['imagen', 'huella', 'autorizacion', 'registro', 'en'])
                    && request.resource.data.imagen is bytes
                    && request.resource.data.imagen.size() <= 512 * 1024
                    && request.resource.data.huella is string
                    && request.resource.data.huella.matches('^[0-9a-f]{64}$')
                    && request.resource.data.registro is string
                    && request.resource.data.en == request.time
                    && firmaConSuRegistroNuevo(persona);
      // Quitar la propia copia no exige seguir siendo admin (como en Storage).
      allow delete: if isSignedIn() && request.auth.uid == custodio;
    }
    // Revisión de ADR-100: un registro suelto mentiría. Un alta/reemplazo solo
    // existe junto con la firma que lo nombra; un retiro solo si la firma deja
    // de existir en la misma operación.
    function registroAtadoASuFirma(id) {
      let firma = /databases/$(database)/documents/firmas_equipo/$(request.auth.uid)/personas/$(request.resource.data.persona);
      return request.resource.data.tipo == 'retiro'
        ? !existsAfter(firma)
        : (existsAfter(firma) && getAfter(firma).data.registro == id);
    }
    match /firmas_equipo_registro/{id} {
      // get y list, ambos SOLO del custodio: otro admin no ve a quién custodia
      // ni con qué autorización (revisión de ADR-099).
      allow get:  if isAdmin() && resource.data.custodio == request.auth.uid;
      allow list: if isAdmin() && request.query.limit <= 50 && resource.data.custodio == request.auth.uid;
      allow create: if isAdmin() && hasProfile()
                    && registroAtadoASuFirma(id)
                    && request.resource.data.keys().hasOnly(['tipo', 'persona', 'autorizacion', 'huella',
                                                             'custodio', 'custodioNombre', 'en'])
                    && request.resource.data.keys().hasAll(['tipo', 'persona', 'custodio', 'custodioNombre', 'en'])
                    && request.resource.data.tipo in ['alta', 'reemplazo', 'retiro']
                    && personaDelEquipo(request.resource.data.persona)
                    && request.resource.data.custodio == request.auth.uid
                    && request.resource.data.custodioNombre == profile().get('nombre', '')
                    && request.resource.data.en == request.time
                    && (request.resource.data.tipo == 'retiro'
                        || (request.resource.data.autorizacion is map
                            && request.resource.data.autorizacion.keys().hasOnly(['fecha', 'medio'])
                            && request.resource.data.autorizacion.fecha is string
                            && request.resource.data.autorizacion.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                            && request.resource.data.autorizacion.medio is string
                            && request.resource.data.autorizacion.medio.size() >= 3
                            && request.resource.data.autorizacion.medio.size() <= 200
                            && request.resource.data.huella is string
                            && request.resource.data.huella.matches('^[0-9a-f]{64}$')));
      allow update, delete: if false;
    }
    match /firmas_delegados/{delegado} {
      function delegacionValida() {
        let d = request.resource.data;
        let u = get(/databases/$(database)/documents/usuarios/$(delegado)).data;
        let reg = rutaRegDeleg(delegado + '_' + d.lote);
        return d.keys().hasOnly(['custodio', 'custodioNombre', 'delegadoNombre', 'personaPropia', 'personas',
                                 'autorizaciones', 'alcance', 'lote', 'en'])
          && d.keys().hasAll(['custodio', 'custodioNombre', 'delegadoNombre', 'personaPropia', 'personas',
                              'autorizaciones', 'alcance', 'lote', 'en'])
          && d.custodio == request.auth.uid && d.custodioNombre == profile().get('nombre', '')
          && delegado != request.auth.uid && u.get('activo', false) == true && d.delegadoNombre == u.get('nombre', '')
          && d.personaPropia in ['CARLOS_MARTELO', 'JORGE_RHENALS']
          && d.personas is list && d.personas.size() >= 1 && d.personas.size() <= 3
          && d.personas.hasOnly(delegables()) && d.personas.toSet().size() == d.personas.size()
          && d.autorizaciones is map && d.autorizaciones.keys().hasOnly(d.personas) && d.autorizaciones.keys().hasAll(d.personas)
          && (!('MIGUEL_JIMENEZ' in d.personas) || autorizacionOk(d.autorizaciones.MIGUEL_JIMENEZ))
          && (!('CARLOS_MARTELO' in d.personas) || autorizacionOk(d.autorizaciones.CARLOS_MARTELO))
          && (!('JORGE_RHENALS' in d.personas) || autorizacionOk(d.autorizaciones.JORGE_RHENALS))
          && d.alcance == 'ordenes' && d.lote is string && d.lote.matches('^[A-Za-z0-9]{20}$') && d.en == request.time
          && !exists(reg) && existsAfter(reg) && getAfter(reg).data.tipo == (resource == null ? 'alta' : 'cambio');
      }
      allow get:    if hasProfile() && ((request.auth.uid == delegado && profile().get('activo', false) == true)
                                        || (isAdmin() && resource.data.custodio == request.auth.uid));
      allow list:   if hasProfile() && isAdmin() && request.query.limit <= 50 && resource.data.custodio == request.auth.uid;
      allow create: if hasProfile() && isAdmin() && delegacionValida();
      allow update: if hasProfile() && isAdmin() && resource.data.custodio == request.auth.uid
                    && request.resource.data.lote != resource.data.lote && delegacionValida();
      // Retirar exige su registro de retiro (id fijo); un custodio que ya no es admin retira sin él.
      allow delete: if isSignedIn() && request.auth.uid == resource.data.custodio
                    && (!isAdmin() || existsAfter(rutaRegDeleg(delegado + '_' + resource.data.lote + '_retiro')));
    }
    function registroDelegacionValido(id) {
      let d = request.resource.data;
      let r = rutaDeleg(d.delegado);
      return d.keys().hasOnly(['tipo', 'delegado', 'delegadoNombre', 'personaPropia', 'personas', 'autorizaciones',
                               'lote', 'custodio', 'custodioNombre', 'en'])
        && d.keys().hasAll(['tipo', 'delegado', 'lote', 'custodio', 'custodioNombre', 'en'])
        && d.tipo in ['alta', 'cambio', 'retiro'] && d.delegado is string && d.lote is string
        && d.custodio == request.auth.uid && d.custodioNombre == profile().get('nombre', '') && d.en == request.time
        && (d.tipo == 'retiro'
            ? (d.keys().hasOnly(['tipo', 'delegado', 'lote', 'custodio', 'custodioNombre', 'en'])
               && id == d.delegado + '_' + d.lote + '_retiro' && exists(r) && get(r).data.custodio == request.auth.uid
               && get(r).data.lote == d.lote && !existsAfter(r))
            : (id == d.delegado + '_' + d.lote && existsAfter(r) && getAfter(r).data.custodio == request.auth.uid
               && getAfter(r).data.lote == d.lote && getAfter(r).data.personas == d.personas
               && getAfter(r).data.autorizaciones == d.autorizaciones
               && getAfter(r).data.personaPropia == d.personaPropia
               && getAfter(r).data.delegadoNombre == d.delegadoNombre
               && (d.tipo == 'alta') == !exists(r)));
    }
    match /firmas_delegados_registro/{id} {
      allow get:  if isAdmin() && resource.data.custodio == request.auth.uid;
      allow list: if isAdmin() && request.query.limit <= 50 && resource.data.custodio == request.auth.uid;
      allow create: if hasProfile() && isAdmin() && registroDelegacionValido(id);
      allow update, delete: if false;
    }
    match /firmas_delegados_fichas/{delegado} {
      function delegacionFichasValida() {
        let d = request.resource.data;
        let u = get(/databases/$(database)/documents/usuarios/$(delegado)).data;
        let reg = rutaRegDelegF(delegado + '_' + d.lote);
        return d.keys().hasOnly(['custodio', 'custodioNombre', 'delegadoNombre', 'personaPropia', 'personas',
                                 'autorizaciones', 'alcance', 'lote', 'en'])
          && d.keys().hasAll(['custodio', 'custodioNombre', 'delegadoNombre', 'personaPropia', 'personas',
                              'autorizaciones', 'alcance', 'lote', 'en'])
          && d.custodio == request.auth.uid && d.custodioNombre == profile().get('nombre', '')
          && delegado != request.auth.uid && u.get('activo', false) == true && d.delegadoNombre == u.get('nombre', '')
          && d.personaPropia in ['CARLOS_MARTELO', 'JORGE_RHENALS']
          && d.personas is list && d.personas.size() >= 1 && d.personas.size() <= 5
          && d.personas.hasOnly(delegablesFichas()) && d.personas.toSet().size() == d.personas.size()
          && d.autorizaciones is map && d.autorizaciones.keys().hasOnly(d.personas) && d.autorizaciones.keys().hasAll(d.personas)
          && (!('MIGUEL_JIMENEZ' in d.personas) || autorizacionOk(d.autorizaciones.MIGUEL_JIMENEZ))
          && (!('CARLOS_MARTELO' in d.personas) || autorizacionOk(d.autorizaciones.CARLOS_MARTELO))
          && (!('JORGE_RHENALS' in d.personas) || autorizacionOk(d.autorizaciones.JORGE_RHENALS))
          && (!('JORGE_MIRANDA' in d.personas) || autorizacionOk(d.autorizaciones.JORGE_MIRANDA))
          && (!('ERICK_VERGARA' in d.personas) || autorizacionOk(d.autorizaciones.ERICK_VERGARA))
          && d.alcance == 'fichas' && d.lote is string && d.lote.matches('^[A-Za-z0-9]{20}$') && d.en == request.time
          && !exists(reg) && existsAfter(reg) && getAfter(reg).data.tipo == (resource == null ? 'alta' : 'cambio');
      }
      allow get:    if hasProfile() && ((request.auth.uid == delegado && profile().get('activo', false) == true)
                                        || (isAdmin() && resource.data.custodio == request.auth.uid));
      allow list:   if hasProfile() && isAdmin() && request.query.limit <= 50 && resource.data.custodio == request.auth.uid;
      allow create: if hasProfile() && isAdmin() && delegacionFichasValida();
      allow update: if hasProfile() && isAdmin() && resource.data.custodio == request.auth.uid
                    && request.resource.data.lote != resource.data.lote && delegacionFichasValida();
      // Retirar exige su registro de retiro (id fijo); un custodio que ya no es admin retira sin él.
      allow delete: if isSignedIn() && request.auth.uid == resource.data.custodio
                    && (!isAdmin() || existsAfter(rutaRegDelegF(delegado + '_' + resource.data.lote + '_retiro')));
    }
    function registroDelegacionFichasValido(id) {
      let d = request.resource.data;
      let r = rutaDelegF(d.delegado);
      return d.keys().hasOnly(['tipo', 'delegado', 'delegadoNombre', 'personaPropia', 'personas', 'autorizaciones',
                               'lote', 'custodio', 'custodioNombre', 'en'])
        && d.keys().hasAll(['tipo', 'delegado', 'lote', 'custodio', 'custodioNombre', 'en'])
        && d.tipo in ['alta', 'cambio', 'retiro'] && d.delegado is string && d.lote is string
        && d.custodio == request.auth.uid && d.custodioNombre == profile().get('nombre', '') && d.en == request.time
        && (d.tipo == 'retiro'
            ? (d.keys().hasOnly(['tipo', 'delegado', 'lote', 'custodio', 'custodioNombre', 'en'])
               && id == d.delegado + '_' + d.lote + '_retiro' && exists(r) && get(r).data.custodio == request.auth.uid
               && get(r).data.lote == d.lote && !existsAfter(r))
            : (id == d.delegado + '_' + d.lote && existsAfter(r) && getAfter(r).data.custodio == request.auth.uid
               && getAfter(r).data.lote == d.lote && getAfter(r).data.personas == d.personas
               && getAfter(r).data.autorizaciones == d.autorizaciones
               && getAfter(r).data.personaPropia == d.personaPropia
               && getAfter(r).data.delegadoNombre == d.delegadoNombre
               && (d.tipo == 'alta') == !exists(r)));
    }
    match /firmas_delegados_fichas_registro/{id} {
      allow get:  if isAdmin() && resource.data.custodio == request.auth.uid;
      allow list: if isAdmin() && request.query.limit <= 50 && resource.data.custodio == request.auth.uid;
      allow create: if hasProfile() && isAdmin() && registroDelegacionFichasValido(id);
      allow update, delete: if false;
    }
    // Rama del DELEGADO en `fichas_emisiones` (ADR-119): lleva `emisor` (quien emite) y
    // `delegacion` (el lote vigente); `custodio` es el DUEÑO del directorio. Cada casilla, una
    // vez, con una persona delegada que cabe en ella y la huella de la firma que HOY está.
    // Cuesta contada: el servidor evalúa a lo sumo 1000 expresiones por petición, y el PE.02081
    // tiene cinco casillas. `x.size() == 5` + leer sus cinco campos (k lo lee `casillasDistintas`)
    // equivale a «exactamente esas claves»: un campo que falte hace fallar la regla.
    function casillaFichasDelegadaOk(x, d, c) {
      return x.size() == 5 && x.nombre.size() <= 80 && x.huella.matches('^[0-9a-f]{64}$')
        && (x.origen == 'propia'
            ? x.persona in [d.personaPropia, '']
            : (x.origen == 'equipo' && x.persona in d.personas && firmanteCabe(x.k, x.persona)
               && x.huella == get(/databases/$(database)/documents/firmas_equipo/$(c)/personas/$(x.persona)).data.huella));
    }
    // Cada casilla una sola vez y todas del formato: las claves, en una lista, sin repetidas.
    function casillasDistintas(cs) {
      let n = cs.size();
      let ks = n == 1 ? [cs[0].k]
        : n == 2 ? [cs[0].k, cs[1].k]
        : n == 3 ? [cs[0].k, cs[1].k, cs[2].k]
        : n == 4 ? [cs[0].k, cs[1].k, cs[2].k, cs[3].k]
        : [cs[0].k, cs[1].k, cs[2].k, cs[3].k, cs[4].k];
      return ks.hasOnly(['elab', 'rev', 'apr', 'apr2', 'rec']) && ks.toSet().size() == n;
    }
    // Todo el folio del delegado en UNA función sobre `e` (= request.resource.data): cada
    // `request.resource.data.x` repetido cuenta como varias expresiones.
    function emisionFichasDelegadaOk(e) {
      let ruta = rutaDelegF(request.auth.uid);
      let d = get(ruta).data;
      let cs = e.casillas;
      let q = e.equipo;
      return e.size() == 10
        && e.keys().hasOnly(['equipo', 'documento', 'casillas', 'huellaArchivo', 'custodio', 'custodioNombre',
                             'emisor', 'emisorNombre', 'delegacion', 'en'])
        && e.documento == 'PE.02081' && e.en == request.time
        && e.huellaArchivo is string && e.huellaArchivo.matches('^[0-9a-f]{64}$')
        && q.size() == 3 && q.keys().hasOnly(['matricula', 'subestacion', 'serie'])
        && q.matricula is string && q.matricula.size() <= 120
        && q.subestacion is string && q.subestacion.size() <= 120
        && q.serie is string && q.serie.size() <= 120
        && cs is list && cs.size() >= 1 && cs.size() <= 5
        && exists(ruta) && delegacionFichasVigente(d, e.custodio)
        && e.emisor == request.auth.uid && e.emisorNombre == profile().get('nombre', '')
        && e.custodioNombre == d.custodioNombre
        && e.delegacion == d.lote
        && casillaFichasDelegadaOk(cs[0], d, e.custodio)
        && (cs.size() < 2 || casillaFichasDelegadaOk(cs[1], d, e.custodio))
        && (cs.size() < 3 || casillaFichasDelegadaOk(cs[2], d, e.custodio))
        && (cs.size() < 4 || casillaFichasDelegadaOk(cs[3], d, e.custodio))
        && (cs.size() < 5 || casillaFichasDelegadaOk(cs[4], d, e.custodio))
        && casillasDistintas(cs);
    }
    match /fichas_emisiones/{folio} {
      allow get:  if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 50;
      allow create: if 'emisor' in request.resource.data && folio.matches('^[A-Za-z0-9]{20}$')
                    && emisionFichasDelegadaOk(request.resource.data);
      allow create: if isAdmin() && hasProfile()
                    && request.resource.data.keys().hasOnly(['equipo', 'documento', 'casillas', 'huellaArchivo',
                                                             'custodio', 'custodioNombre', 'en'])
                    && request.resource.data.keys().hasAll(['equipo', 'documento', 'casillas', 'huellaArchivo',
                                                            'custodio', 'custodioNombre', 'en'])
                    && request.resource.data.equipo is map
                    && request.resource.data.equipo.keys().hasOnly(['matricula', 'subestacion', 'serie'])
                    && request.resource.data.documento == 'PE.02081'
                    && request.resource.data.casillas is list
                    && request.resource.data.casillas.size() >= 1
                    && request.resource.data.casillas.size() <= 5
                    && request.resource.data.huellaArchivo is string
                    && request.resource.data.huellaArchivo.matches('^[0-9a-f]{64}$')
                    && request.resource.data.custodio == request.auth.uid
                    && request.resource.data.custodioNombre == profile().get('nombre', '')
                    && request.resource.data.en == request.time;
      allow update, delete: if false;
    }

    // ── Órdenes de Entrada/Salida (IT.05801) · emisiones con firmas del equipo ──
    // Cada PDF o Excel de una orden que lleva firmas del directorio del custodio
    // queda aquí (decisión del Ingeniero 2026-09-28: «Entregado» como en Fichas).
    // Mismo contrato que `fichas_emisiones`: SOLO se agrega, a nombre de quien emite.
    // Rama del DELEGADO (ADR-117): lleva `emisor` (quien emite) y `delegacion` (el lote vigente);
    // `custodio` es el DUEÑO del directorio. Cada casilla, en su línea y de las personas delegadas.
    function casillaDelegadaOk(x, d, c) {
      return x is map && x.keys().hasOnly(['rol', 'persona', 'nombre', 'origen', 'huella'])
        && x.get('nombre', '') is string && x.get('nombre', '').size() <= 80
        && x.get('huella', '') is string && x.get('huella', '').matches('^[0-9a-f]{64}$')
        && ((x.get('origen', '') == 'propia' && x.get('rol', '') == 'entregado' && x.get('persona', '') == d.personaPropia)
            || (x.get('origen', '') == 'equipo' && x.get('persona', '') in d.personas
                && ((x.get('rol', '') == 'autorizado' && x.persona == 'MIGUEL_JIMENEZ')
                    || (x.get('rol', '') == 'entregado' && x.persona in ['CARLOS_MARTELO', 'JORGE_RHENALS']))
                // La huella declarada es la de la firma que HOY está en el directorio (revisión §117).
                && x.huella == get(/databases/$(database)/documents/firmas_equipo/$(c)/personas/$(x.persona)).data.huella));
    }
    function emisionDelegadaOk(e) {
      let ruta = rutaDeleg(request.auth.uid);
      let d = get(ruta).data;
      return exists(ruta) && delegacionVigente(d, e.custodio)
        && e.emisor == request.auth.uid && e.emisorNombre == profile().get('nombre', '')
        && e.custodioNombre == d.custodioNombre
        && e.delegacion == d.lote
        // Una casilla por línea: a lo sumo «Autorizado» y «Entregado» (Recibido va a mano).
        && e.casillas.size() <= 2
        && (e.casillas.size() < 2 || e.casillas[0].get('rol', '') != e.casillas[1].get('rol', ''))
        && e.orden.get('tipo', '') in ['ENTRADA', 'SALIDA']
        && e.orden.get('numero', '') is string && e.orden.get('numero', '').size() <= 30
        && e.orden.get('zona', '') is string && e.orden.get('zona', '').size() <= 60
        && e.orden.get('fecha', '') is string && e.orden.get('fecha', '').size() <= 20
        && (e.casillas.size() < 1 || casillaDelegadaOk(e.casillas[0], d, e.custodio))
        && (e.casillas.size() < 2 || casillaDelegadaOk(e.casillas[1], d, e.custodio));
    }
    function emisionComunOk(e) {
      return e.orden is map
        && e.orden.keys().hasOnly(['tipo', 'numero', 'zona', 'fecha'])
        && e.documento == 'IT.05801'
        && e.formato in ['pdf', 'xlsx']
        && e.casillas is list
        && e.casillas.size() >= 1
        && e.casillas.size() <= 3
        && e.huellaArchivo is string
        && e.huellaArchivo.matches('^[0-9a-f]{64}$')
        && e.en == request.time;
    }
    match /ordenes_emisiones/{folio} {
      allow get:  if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 50;
      allow create: if hasProfile() && 'emisor' in request.resource.data && folio.matches('^[A-Za-z0-9]{20}$')
                    && request.resource.data.keys().hasOnly(['orden', 'documento', 'formato', 'casillas', 'huellaArchivo',
                                                             'custodio', 'custodioNombre', 'emisor', 'emisorNombre',
                                                             'delegacion', 'en'])
                    && request.resource.data.keys().hasAll(['orden', 'documento', 'formato', 'casillas', 'huellaArchivo',
                                                            'custodio', 'custodioNombre', 'emisor', 'emisorNombre',
                                                            'delegacion', 'en'])
                    && emisionComunOk(request.resource.data)
                    && emisionDelegadaOk(request.resource.data);
      allow create: if isAdmin() && hasProfile()
                    && request.resource.data.keys().hasOnly(['orden', 'documento', 'formato', 'casillas', 'huellaArchivo',
                                                             'custodio', 'custodioNombre', 'en'])
                    && request.resource.data.keys().hasAll(['orden', 'documento', 'formato', 'casillas', 'huellaArchivo',
                                                            'custodio', 'custodioNombre', 'en'])
                    && request.resource.data.orden is map
                    && request.resource.data.orden.keys().hasOnly(['tipo', 'numero', 'zona', 'fecha'])
                    && request.resource.data.documento == 'IT.05801'
                    && request.resource.data.formato in ['pdf', 'xlsx']
                    && request.resource.data.casillas is list
                    && request.resource.data.casillas.size() >= 1
                    && request.resource.data.casillas.size() <= 3
                    && request.resource.data.huellaArchivo is string
                    && request.resource.data.huellaArchivo.matches('^[0-9a-f]{64}$')
                    && request.resource.data.custodio == request.auth.uid
                    && request.resource.data.custodioNombre == profile().get('nombre', '')
                    && request.resource.data.en == request.time;
      allow update, delete: if false;
    }

    // ── Fichas · «Diagrama Operativo» (ADR-112) ──
    // Un adjunto por TRANSFORMADOR: la meta en fichas_adjuntos/{id} y la imagen
    // aprobada en partes/{0..2} (bytes ≤ 900 KB, a lo sumo 3), atadas por `lote`
    // para que un reemplazo nunca mezcle ni deje partes sueltas. El id sale de la
    // identidad PERSISTENTE (M:matrícula / S:serie). Lo escriben SOLO
    // administradores con perfil; lo leen los miembros del equipo (exportan con
    // él). Nadie lista partes. Registro que SOLO se agrega y sin bytes.
    function rutaAdjunto(id) { return /databases/$(database)/documents/fichas_adjuntos/$(id); }
    // Revisión de ADR-112: todo cambio deja su registro con id FIJO (sin él no hay
    // cambio), como las firmas del equipo (ADR-099).
    function rutaRegistroAdjunto(rid) { return /databases/$(database)/documents/fichas_adjuntos_registro/$(rid); }
    function autorAdjuntoValido(p) {
      return p is map && p.keys().hasOnly(['uid', 'nombre']) && p.keys().hasAll(['uid', 'nombre'])
        && p.uid == request.auth.uid && p.nombre == profile().get('nombre', '');
    }
    function metaAdjuntoValida(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['clave', 'matricula', 'serie', 'documento', 'tipo', 'origen', 'mime', 'ancho', 'alto',
                               'tamano', 'partes', 'huella', 'lote', 'subidoPor', 'en'])
        && d.keys().hasAll(['clave', 'matricula', 'serie', 'documento', 'tipo', 'origen', 'mime', 'ancho', 'alto',
                            'tamano', 'partes', 'huella', 'lote', 'subidoPor', 'en'])
        && d.clave is string && d.clave.matches('^[MS]:.{1,80}$')
        && id == 'salud_' + hashing.sha256(d.clave).toHexString().lower()
        && ((d.clave[0:2] == 'M:' && d.matricula == d.clave[2:d.clave.size()])
            || (d.clave[0:2] == 'S:' && d.serie == d.clave[2:d.clave.size()]))
        && d.matricula is string && d.matricula.size() <= 80
        && d.serie is string && d.serie.size() <= 80
        && d.documento == 'salud'
        && d.tipo in ['imagen', 'excel']
        && d.origen is map && d.origen.keys().hasOnly(['nombre', 'hoja'])
        && d.origen.nombre is string && d.origen.nombre.size() >= 1 && d.origen.nombre.size() <= 120
        && (!('hoja' in d.origen) || (d.origen.hoja is string && d.origen.hoja.size() <= 31))
        && d.mime in ['image/png', 'image/jpeg']
        && d.ancho is int && d.ancho >= 1 && d.ancho <= 5000
        && d.alto is int && d.alto >= 1 && d.alto <= 5000
        && d.tamano is int && d.tamano >= 1 && d.tamano <= 3 * 900 * 1024
        && d.partes is int && d.partes >= 1 && d.partes <= 3
        && d.huella is string && d.huella.matches('^[0-9a-f]{64}$')
        && d.lote is string && d.lote.matches('^[A-Za-z0-9]{20}$')
        && autorAdjuntoValido(d.subidoPor)
        && d.en == request.time;
    }
    // ADR-118 (el Ingeniero, 2026-09-29): además del admin, adjunta y REEMPLAZA quien tenga en su
    // perfil el permiso «fichas.adjuntar_operativo» (lo pone solo el admin en /usuarios). Quitar,
    // solo el admin. Espejo de `domain/permiso_operativo.js`.
    function parteDelLote(id, k) {
      let r = /databases/$(database)/documents/fichas_adjuntos/$(id)/partes/$(string(k));
      return k >= request.resource.data.partes
        || (existsAfter(r) && getAfter(r).data.lote == request.resource.data.lote);
    }
    function puedeAdjuntarOperativo() {
      return hasProfile() && (isAdmin()
        || (profile().get('activo', false) == true
            && profile().get('permisos_extra', []) is list
            && profile().get('permisos_extra', []).hasAny(['fichas.adjuntar_operativo'])));
    }
    match /fichas_adjuntos/{id} {
      allow get:  if isTeamMember();
      allow list: if isAdmin() && request.query.limit <= 50;
      allow create, update: if puedeAdjuntarOperativo() && id.matches('^salud_[0-9a-f]{64}$') && metaAdjuntoValida(id)
                    && (resource == null || resource.data.lote != request.resource.data.lote)
                    // Revisión de ADR-118: la meta nueva va CON todas sus partes del mismo lote (no queda
                    // un Diagrama ilegible sin «retiro», ni con permiso ni por error).
                    && parteDelLote(id, 0) && parteDelLote(id, 1) && parteDelLote(id, 2)
                    && existsAfter(rutaRegistroAdjunto(id + '_' + request.resource.data.lote))
                    && getAfter(rutaRegistroAdjunto(id + '_' + request.resource.data.lote)).data.accion == (resource == null ? 'alta' : 'reemplazo');
      // Quitar: la meta se va solo si en el mismo lote se van sus tres partes y queda su «retiro».
      allow delete: if isAdmin() && hasProfile()
                    && existsAfter(rutaRegistroAdjunto(id + '_' + resource.data.lote + '_retiro'))
                    && !existsAfter(/databases/$(database)/documents/fichas_adjuntos/$(id)/partes/0)
                    && !existsAfter(/databases/$(database)/documents/fichas_adjuntos/$(id)/partes/1)
                    && !existsAfter(/databases/$(database)/documents/fichas_adjuntos/$(id)/partes/2);
      match /partes/{n} {
        allow get: if isTeamMember();
        allow create, update: if puedeAdjuntarOperativo() && n in ['0', '1', '2']
                      && request.resource.data.keys().hasOnly(['bytes', 'lote'])
                      && request.resource.data.bytes is bytes
                      && request.resource.data.bytes.size() >= 1
                      && request.resource.data.bytes.size() <= 900 * 1024
                      && existsAfter(rutaAdjunto(id))
                      // Una parte solo se escribe en la MISMA operación que cambia el lote de su meta.
                      && (!exists(rutaAdjunto(id)) || get(rutaAdjunto(id)).data.lote != getAfter(rutaAdjunto(id)).data.lote)
                      && request.resource.data.lote == getAfter(rutaAdjunto(id)).data.lote
                      && int(n) < getAfter(rutaAdjunto(id)).data.partes;
        allow delete: if isAdmin() && hasProfile() && n in ['0', '1', '2']
                      && (!existsAfter(rutaAdjunto(id)) || int(n) >= getAfter(rutaAdjunto(id)).data.partes);
        // Quien adjunta con permiso borra SOLO los espacios que sobran en un reemplazo (la meta sigue).
        allow delete: if puedeAdjuntarOperativo() && n in ['0', '1', '2']
                      && existsAfter(rutaAdjunto(id)) && int(n) >= getAfter(rutaAdjunto(id)).data.partes;
      }
    }
    match /fichas_adjuntos_registro/{rid} {
      allow get:  if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 50;
      allow create: if puedeAdjuntarOperativo()
                    // «retiro» (quitar) solo el admin; alta y reemplazo, también quien tiene el permiso.
                    && (isAdmin() || request.resource.data.get('accion', '') in ['alta', 'reemplazo'])
                    && request.resource.data.keys().hasOnly(['idAdjunto', 'accion', 'lote', 'nombre', 'huella', 'tamano', 'subidoPor', 'en'])
                    && request.resource.data.keys().hasAll(['idAdjunto', 'accion', 'lote', 'nombre', 'huella', 'tamano', 'subidoPor', 'en'])
                    && request.resource.data.idAdjunto is string
                    && request.resource.data.idAdjunto.matches('^salud_[0-9a-f]{64}$')
                    && request.resource.data.accion in ['alta', 'reemplazo', 'retiro']
                    && request.resource.data.lote is string && request.resource.data.lote.matches('^[A-Za-z0-9]{20}$')
                    && rid == request.resource.data.idAdjunto + '_' + request.resource.data.lote + (request.resource.data.accion == 'retiro' ? '_retiro' : '')
                    && (request.resource.data.accion == 'retiro'
                        ? !existsAfter(rutaAdjunto(request.resource.data.idAdjunto))
                        : (existsAfter(rutaAdjunto(request.resource.data.idAdjunto))
                           && getAfter(rutaAdjunto(request.resource.data.idAdjunto)).data.lote == request.resource.data.lote))
                    && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 120
                    && request.resource.data.huella is string && request.resource.data.huella.matches('^[0-9a-f]{64}$')
                    && request.resource.data.tamano is int && request.resource.data.tamano >= 0
                    && autorAdjuntoValido(request.resource.data.subidoPor)
                    && request.resource.data.en == request.time;
      allow update, delete: if false;
    }

    // ── Placa característica de cada transformador (TODO-69, ADR-166) ─────────────────────────────
    // Lo leído de la placa + la foto JPEG en partes ≤ 900 KB atadas por `lote` (método de fichas_adjuntos;
    // Storage no entrega descargas, §100). Lee el equipo; carga el administrador con perfil, que firma la carga.
    // Cada carga trae un `paquete` NUEVO, sus partes en la MISMA operación y su registro de solo agregar.
    // Nada de aquí toca el inventario: las diferencias con la placa solo se muestran.
    function rutaPlaca(id) { return /databases/$(database)/documents/placas_caracteristicas/$(id); }
    function rutaPartePlaca(id, k) { return /databases/$(database)/documents/placas_caracteristicas/$(id)/partes/$(string(k)); }
    function rutaRegPlaca(rid) { return /databases/$(database)/documents/placas_caracteristicas_registro/$(rid); }
    function fotoPlacaValida(f) {
      return f == null || (f is map
        && f.keys().hasOnly(['partes', 'lote', 'huella', 'mime', 'ancho', 'alto', 'bytes', 'origen'])
        && f.keys().hasAll(['partes', 'lote', 'huella', 'mime', 'ancho', 'alto', 'bytes', 'origen'])
        && f.partes is int && f.partes >= 1 && f.partes <= 3
        && f.lote is string && f.lote.matches('^[A-Za-z0-9]{8,40}$')
        && f.huella is string && f.huella.matches('^[0-9a-f]{64}$')
        && f.mime == 'image/jpeg' && f.origen in ['foto', 'pdf']
        && f.ancho is int && f.ancho >= 1 && f.ancho <= 5000
        && f.alto is int && f.alto >= 1 && f.alto <= 5000
        && f.bytes is int && f.bytes >= 1 && f.bytes <= f.partes * 900 * 1024);
    }
    function datosPlacaValidos(d) {
      return d is map && d.keys().hasOnly(['fabricante', 'serie', 'serie_nota', 'anio', 'norma', 'fases', 'potencias_texto', 'etapas_kva', 'tension',
          'impedancia_pct', 'impedancia_base_kva', 'perdidas_carga_w', 'perdidas_base_kva', 'perdidas_temp_c', 'perdidas_vacio_w',
          'elevacion_devanado_c', 'elevacion_aceite_c', 'ambiente_max_c', 'altitud_m', 'masa_total_kg', 'aceite_l', 'ventiladores', 'notas'])
        && (d.get('notas', null) == null || (d.notas is string && d.notas.size() <= 4000))
        && (d.get('serie', null) == null || (d.serie is string && d.serie.size() <= 120))
        && (d.get('potencias_texto', null) == null || (d.potencias_texto is string && d.potencias_texto.size() <= 600))
        && d.get('etapas_kva', {}) is map && d.get('etapas_kva', {}).size() <= 6
        && d.get('tension', {}) is map && d.get('tension', {}).keys().hasOnly(['P', 'S', 'T']);
    }
    function fuentePlacaValida(f) {
      return f is map && f.keys().hasOnly(['tipo', 'fecha', 'lecturas', 'estado', 'confianza', 'alertas', 'huella_datos'])
        && f.tipo == 'lectura_de_foto' && f.fecha is string && f.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && f.huella_datos is string && f.huella_datos.matches('^[0-9a-f]{64}$')
        && (f.get('alertas', null) == null || (f.alertas is string && f.alertas.size() <= 2000));
    }
    // Parte k: si sobra (sin foto o k >= partes) NO existe después; si toca, existe con el lote de la foto. Con una
    // sola parte (todas las del paquete), su SHA-256 debe ser la huella declarada: la huella queda atada a los bytes.
    function partePlacaDelLote(id, k) {
      let f = request.resource.data.foto;
      return (f == null || k >= f.partes)
        ? !existsAfter(rutaPartePlaca(id, k))
        : (existsAfter(rutaPartePlaca(id, k)) && getAfter(rutaPartePlaca(id, k)).data.lote == f.lote
           && (k != 0 || f.partes != 1 || hashing.sha256(getAfter(rutaPartePlaca(id, k)).data.bytes).toHexString().lower() == f.huella));
    }
    match /placas_caracteristicas/{id} {
      allow get:  if isTeamMember();
      allow list: if isAdmin() && request.query.limit <= 50;
      allow create, update: if isAdmin() && hasProfile()
                    && id.matches('^[A-Za-z0-9]{6,64}$')
                    && request.resource.data.keys().hasOnly(['schema', 'matricula', 'datos', 'fuente', 'foto', 'carga'])
                    && request.resource.data.keys().hasAll(['schema', 'matricula', 'datos', 'fuente', 'foto', 'carga'])
                    && request.resource.data.schema == 1
                    && request.resource.data.matricula is string && request.resource.data.matricula.trim().size() >= 3
                    && request.resource.data.matricula.size() <= 40
                    // La placa es de ESE transformador: su matrícula es la del inventario.
                    && get(/databases/$(database)/documents/transformadores/$(id)).data.get('identificacion', {}).get('matricula', '') == request.resource.data.matricula
                    && datosPlacaValidos(request.resource.data.datos)
                    && fuentePlacaValida(request.resource.data.fuente)
                    && fotoPlacaValida(request.resource.data.foto)
                    && request.resource.data.carga is map
                    && request.resource.data.carga.keys().hasOnly(['por', 'en', 'paquete'])
                    && request.resource.data.carga.por == request.auth.uid
                    && request.resource.data.carga.en == request.time
                    && request.resource.data.carga.paquete is string && request.resource.data.carga.paquete.matches('^[A-Za-z0-9-]{4,40}$')
                    && (resource == null || resource.data.carga.paquete != request.resource.data.carga.paquete)
                    && partePlacaDelLote(id, 0) && partePlacaDelLote(id, 1) && partePlacaDelLote(id, 2)
                    && existsAfter(rutaRegPlaca(id + '_' + request.resource.data.carga.paquete));
      // Retirar: la meta se va solo con sus tres partes y deja su «retiro».
      allow delete: if isAdmin() && hasProfile()
                    && existsAfter(rutaRegPlaca(id + '_' + resource.data.carga.paquete + '_retiro'))
                    && !existsAfter(rutaPartePlaca(id, 0)) && !existsAfter(rutaPartePlaca(id, 1)) && !existsAfter(rutaPartePlaca(id, 2));
      match /partes/{n} {
        allow get: if isTeamMember();
        allow create, update: if isAdmin() && hasProfile() && n in ['0', '1', '2']
                      && request.resource.data.keys().hasOnly(['bytes', 'lote'])
                      && request.resource.data.bytes is bytes
                      && request.resource.data.bytes.size() >= 1
                      && request.resource.data.bytes.size() <= 900 * 1024
                      // La parte 0 empieza como un JPEG (FF D8 FF).
                      && (n != '0' || request.resource.data.bytes.toHexString()[0:6].upper() == 'FFD8FF')
                      && existsAfter(rutaPlaca(id)) && getAfter(rutaPlaca(id)).data.foto != null
                      // Solo en la MISMA operación que cambia la carga de su meta.
                      && (!exists(rutaPlaca(id)) || get(rutaPlaca(id)).data.carga.paquete != getAfter(rutaPlaca(id)).data.carga.paquete)
                      && request.resource.data.lote == getAfter(rutaPlaca(id)).data.foto.lote
                      && int(n) < getAfter(rutaPlaca(id)).data.foto.partes;
        // Borrar solo lo que sobra, o todo cuando la meta se va.
        allow delete: if isAdmin() && hasProfile() && n in ['0', '1', '2']
                      && (!existsAfter(rutaPlaca(id)) || getAfter(rutaPlaca(id)).data.foto == null
                          || int(n) >= getAfter(rutaPlaca(id)).data.foto.partes);
      }
    }
    match /placas_caracteristicas_registro/{rid} {
      allow get:  if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 50;
      allow create: if isAdmin() && hasProfile()
                    && request.resource.data.keys().hasOnly(['idPlaca', 'accion', 'paquete', 'matricula', 'huella', 'huellaDatos', 'por', 'en'])
                    && request.resource.data.keys().hasAll(['idPlaca', 'accion', 'paquete', 'matricula', 'huella', 'huellaDatos', 'por', 'en'])
                    && request.resource.data.idPlaca is string && request.resource.data.idPlaca.matches('^[A-Za-z0-9]{6,64}$')
                    && request.resource.data.accion in ['alta', 'reemplazo', 'retiro']
                    && request.resource.data.paquete is string && request.resource.data.paquete.matches('^[A-Za-z0-9-]{4,40}$')
                    && request.resource.data.matricula is string && request.resource.data.matricula.size() <= 40
                    && rid == request.resource.data.idPlaca + '_' + request.resource.data.paquete
                              + (request.resource.data.accion == 'retiro' ? '_retiro' : '')
                    // Un «retiro» solo de una placa que EXISTÍA con ese paquete y se va en esta misma operación.
                    && (request.resource.data.accion == 'retiro'
                        ? (exists(rutaPlaca(request.resource.data.idPlaca))
                           && get(rutaPlaca(request.resource.data.idPlaca)).data.carga.paquete == request.resource.data.paquete
                           && !existsAfter(rutaPlaca(request.resource.data.idPlaca)))
                        : (existsAfter(rutaPlaca(request.resource.data.idPlaca))
                           && getAfter(rutaPlaca(request.resource.data.idPlaca)).data.carga.paquete == request.resource.data.paquete))
                    && request.resource.data.huella is string && request.resource.data.huella.matches('^([0-9a-f]{64}|sinfoto)$')
                    && request.resource.data.huellaDatos is string && request.resource.data.huellaDatos.matches('^[0-9a-f]{64}$')
                    && request.resource.data.por == request.auth.uid && request.resource.data.en == request.time;
      allow update, delete: if false;
    }

    match /responsables_ordenes/{id} {
      allow get:  if isTeamMember();
      allow list: if isTeamMember() && isAdmin() && request.query.limit <= 50;
      allow create, update: if isTeamMember() && isAdmin() && hasProfile()
                    && request.resource.data.keys().hasOnly(['nombre', 'cedula', 'autorizacion',
                                                             'actualizadoPor', 'actualizadoEn'])
                    && request.resource.data.keys().hasAll(['nombre', 'cedula', 'autorizacion',
                                                            'actualizadoPor', 'actualizadoEn'])
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() <= 80
                    && request.resource.data.nombre.matches('^[A-ZÑ]+( [A-ZÑ]+)*$')
                    && id == request.resource.data.nombre.replace(' ', '_')
                    && request.resource.data.cedula is string
                    && request.resource.data.cedula.matches('^[0-9]{5,12}$')
                    && request.resource.data.autorizacion is map
                    && request.resource.data.autorizacion.keys().hasOnly(['fecha', 'medio'])
                    && request.resource.data.autorizacion.fecha is string
                    && request.resource.data.autorizacion.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.autorizacion.medio is string
                    && request.resource.data.autorizacion.medio.size() >= 3
                    && request.resource.data.autorizacion.medio.size() <= 120
                    && request.resource.data.actualizadoPor is map
                    && request.resource.data.actualizadoPor.keys().hasOnly(['uid', 'nombre'])
                    && request.resource.data.actualizadoPor.uid == request.auth.uid
                    && request.resource.data.actualizadoPor.nombre == profile().get('nombre', '')
                    && request.resource.data.actualizadoEn == request.time;
      allow delete: if isTeamMember() && isAdmin();
    }

    // ── Cargabilidad SCADA (ADR-122, decisión del Ingeniero 2026-09-30) ──────────────
    // Mediciones horarias del SCADA por punto y mes, ya limpias y compactas (Bytes), su
    // resumen mensual, el catálogo de lo cargado, la homologación matrícula ↔ punto y el
    // registro de cada carga. Lee el equipo activo SOLO por id (nada de listados de lo
    // grande); escribe solo un administrador CON perfil, a su nombre y con la hora del
    // servidor. Nada se borra. Los datos son operativos del cliente: viven aquí, nunca en el
    // repositorio público (la guardia scripts/guardia-scada.mjs lo hace cumplir).
    function scadaAdmin() { return hasProfile() && isAdmin(); }
    function scadaQuien(p) {
      return p is map && p.keys().hasOnly(['uid', 'nombre']) && p.uid == request.auth.uid
        && p.nombre == profile().get('nombre', '');
    }
    function scadaSello(d) { return d.actualizadoEn == request.time && scadaQuien(d.actualizadoPor); }
    match /scada_series/{id} {
      allow get: if isTeamMember();
      allow list: if false;
      allow create, update: if scadaAdmin()
        && id.matches('[a-z0-9_-]{1,40}__[a-z0-9_-]{1,40}__20[0-9]{2}-(0[1-9]|1[0-2])')
        && request.resource.data.keys().hasOnly(['schema', 'claveId', 'clave', 'est', 'elem', 'mes', 'n', 'formato', 'niveles',
             'cargaId', 'actualizadoPor', 'actualizadoEn'])
        && request.resource.data.schema == 1 && request.resource.data.formato == 'v32le+m8+b8'
        && id == request.resource.data.claveId + '__' + request.resource.data.mes
        && request.resource.data.n is int && request.resource.data.n >= 672 && request.resource.data.n <= 744
        && request.resource.data.niveles is map && request.resource.data.niveles.size() <= 6
        && request.resource.data.cargaId is string
        && scadaSello(request.resource.data);
      allow delete: if false;
    }
    match /scada_resumen/{mes} {
      allow get: if isTeamMember();
      allow list: if false;
      allow create, update: if scadaAdmin()
        && mes.matches('20[0-9]{2}-(0[1-9]|1[0-2])') && request.resource.data.mes == mes
        && request.resource.data.keys().hasOnly(['schema', 'mes', 'claves', 'cargaId', 'actualizadoPor', 'actualizadoEn'])
        && request.resource.data.claves is map && request.resource.data.cargaId is string
        && (resource == null || request.resource.data.claves.keys().hasAll(resource.data.claves.keys()))
        && scadaSello(request.resource.data);
      allow delete: if false;
    }
    match /scada_catalogo/{id} {
      allow get: if isTeamMember();
      allow list: if false;
      allow create, update: if scadaAdmin() && id == 'estado'
        && request.resource.data.keys().hasOnly(['schema', 'meses', 'puntos', 'cargaId', 'actualizadoPor', 'actualizadoEn'])
        && request.resource.data.meses is map && request.resource.data.puntos is map && request.resource.data.cargaId is string
        && (resource == null || (request.resource.data.meses.keys().hasAll(resource.data.meses.keys())
            && request.resource.data.puntos.keys().hasAll(resource.data.puntos.keys())))
        && scadaSello(request.resource.data);
      allow delete: if false;
    }
    // Registro de cada carga: se abre 'iniciada' ANTES del primer lote y se cierra UNA vez, por su autor.
    match /scada_cargas/{id} {
      allow get: if isTeamMember();
      allow list: if isTeamMember() && request.query.limit <= 20;
      allow create: if scadaAdmin()
        && request.resource.data.keys().hasOnly(['estado', 'modo', 'meses', 'carpeta', 'plan', 'simulacion', 'abiertaEn', 'por'])
        && request.resource.data.estado == 'iniciada'
        && request.resource.data.modo in ['completar', 'reemplazar', 'ensayo']
        && request.resource.data.abiertaEn == request.time && scadaQuien(request.resource.data.por);
      allow update: if scadaAdmin()
        && resource.data.estado == 'iniciada' && resource.data.por.uid == request.auth.uid
        && request.resource.data.estado in ['completa', 'parcial', 'fallida']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'escrituras', 'duracion_ms', 'error', 'detalle', 'cerradoEn'])
        && request.resource.data.cerradoEn == request.time;
      allow delete: if false;
    }
    // Homologación: UN documento con versión (rev) y un registro ATADO a cada cambio. Las filas no
    // disminuyen (una fila que sale del Excel queda «retirada»); una confirmación toca UNA fila.
    function homologacionConSuRegistro() {
      let d = request.resource.data;
      let ruta = /databases/$(database)/documents/scada_homologacion_registro/$(d.ultimoRegistro);
      let reg = getAfter(ruta).data;
      return d.ultimoRegistro is string && !exists(ruta) && existsAfter(ruta) && reg.rev == d.rev
        && (reg.tipo == 'carga_excel'
          || (resource != null && reg.filaId in resource.data.filas
              && d.diff(resource.data).affectedKeys().hasOnly(['filas', 'rev', 'ultimoRegistro', 'actualizadoPor', 'actualizadoEn'])
              && d.filas.diff(resource.data.filas).affectedKeys().hasOnly([reg.filaId])));
    }
    match /scada_homologacion/{id} {
      allow get: if isTeamMember();
      allow list: if false;
      allow create, update: if scadaAdmin() && id == 'vigente'
        && request.resource.data.keys().hasOnly(['schema', 'rev', 'fuente', 'filas', 'ultimoRegistro', 'actualizadoPor', 'actualizadoEn'])
        && request.resource.data.schema == 1
        && request.resource.data.rev == (resource == null ? 1 : resource.data.rev + 1)
        && request.resource.data.filas is map && request.resource.data.filas.size() <= 400
        && (resource == null || request.resource.data.filas.size() >= resource.data.filas.size())
        && scadaSello(request.resource.data)
        && homologacionConSuRegistro();
      allow delete: if false;
    }
    function registroAtadoAVigente(id) {
      let v = /databases/$(database)/documents/scada_homologacion/vigente;
      let r = request.resource.data;
      let tras = getAfter(v).data;
      return existsAfter(v) && tras.ultimoRegistro == id && tras.rev == r.rev
        && (r.tipo == 'carga_excel'
          || (r.filaId is string && r.filaId in tras.filas
              && tras.filas[r.filaId].get('decision', null) == r.despues
              && (r.tipo == 'reapertura' ? r.despues == null : r.despues != null)
              && previasSeConservan(v, r)));
    }
    // Cambio de medida (2026-10-26): una CONFIRMACIÓN no puede perder las medidas anteriores de la fila (`decision.previas`):
    // un diálogo viejo en caché, o abierto antes del cambio, rehace la decisión desde cero y las borraría sin aviso. Solo
    // «Reabrir» (decisión null, queda en el registro) las quita.
    function previasSeConservan(v, r) {
      let antes = get(v).data.filas.get(r.filaId, {}).get('decision', null);
      return r.tipo != 'confirmacion' || antes == null || !('previas' in antes) || antes.previas.size() == 0
        || (r.despues.get('previas', null) is map && r.despues.previas.keys().hasAll(antes.previas.keys()));
    }
    match /scada_homologacion_registro/{id} {
      allow get: if isTeamMember();
      allow list: if isTeamMember() && request.query.limit <= 20;
      allow create: if scadaAdmin()
        && request.resource.data.keys().hasOnly(['tipo', 'rev', 'filaId', 'antes', 'despues', 'resumen', 'por', 'en'])
        && request.resource.data.tipo in ['carga_excel', 'confirmacion', 'reapertura']
        && request.resource.data.rev is int
        && scadaQuien(request.resource.data.por) && request.resource.data.en == request.time
        && registroAtadoAVigente(id);
      allow update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════
    // Informe de Mantenimiento Brigada · formato F60-ADM (TODO-81)
    // Lo LEE el equipo activo; lo ARMAN solo los editores de
    // informes_brigada_config/general (lista de uid, nunca nombres); ANULA un
    // administrador; nadie borra. `rev` sube de a uno (nadie pisa a otro en
    // silencio) y emitir deja su copia congelada en versiones/{n} en la MISMA
    // escritura. Las mismas constantes viven en
    // assets/js/domain/informe_brigada_rutas.js (una prueba las amarra).
    // ══════════════════════════════════════════════════════════════
    function ibrRutaConfig() { return /databases/$(database)/documents/informes_brigada_config/general; }
    function ibrRutaInforme(id) { return /databases/$(database)/documents/informes_brigada/$(id); }
    function ibrRutaVersion(id, n) { return /databases/$(database)/documents/informes_brigada/$(id)/versiones/$(n); }
    function ibrRutaParteFicha(f) { return /databases/$(database)/documents/informes_brigada_fichas/$(f)/partes/0; }
    function ibrEditor() {
      return hasProfile() && profile().activo == true
        && exists(ibrRutaConfig())
        && request.auth.uid in get(ibrRutaConfig()).data.editores;
    }
    function ibrAutor(p) {
      return p is map && p.keys().hasOnly(['uid', 'nombre']) && p.keys().hasAll(['uid', 'nombre'])
        && p.uid == request.auth.uid && p.nombre == profile().get('nombre', '');
    }
    function ibrHuella(h) { return h is string && h.matches('^[0-9a-f]{64}$'); }
    function ibrSello(d) { return ibrAutor(d.actualizadoPor) && d.actualizadoEn == request.time; }
    function ibrClaves() {
      return ['esquema', 'modelo', 'actividad', 'equipo_ref', 'estado', 'version', 'rev', 'contenido',
              'anulacion', 'creadoPor', 'creadoEn', 'actualizadoPor', 'actualizadoEn', 'emitidoPor', 'emitidoEn'];
    }
    function ibrEquipoRef(e) {
      return e is map && e.keys().hasOnly(['transformador_id', 'matricula', 'subestacion', 'serie'])
        && e.keys().hasAll(['transformador_id', 'matricula'])
        && e.matricula is string && e.matricula.size() >= 1 && e.matricula.size() <= 40
        && e.transformador_id is string && e.transformador_id.size() <= 128;
    }
    // Actividad (pedido del Ingeniero, 2026-10-26): de la lista de motivos o escrita a mano; todas usan
    // el único modelo (F60). Una sola línea, sin espacios sobrantes (ni a los lados ni dobles), sin
    // caracteres de control ni marcas invisibles de copiar y pegar, de 3 a 200 caracteres y con al menos
    // una letra latina (con o sin tilde) o un número. Los mismos patrones y topes viven en
    // assets/js/domain/informe_brigada_actividad.js (una prueba los amarra). Después de crear no cambia (ibrFijos).
    function ibrActividad(a) {
      return a is string && a.size() >= 3 && a.size() <= 200
        && a.matches('^[^\\p{Cc}\\p{Z}\\x{00AD}\\x{115F}\\x{1160}\\x{180E}\\x{200B}\\x{200E}\\x{200F}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{3164}\\x{FEFF}\\x{FFA0}]+( [^\\p{Cc}\\p{Z}\\x{00AD}\\x{115F}\\x{1160}\\x{180E}\\x{200B}\\x{200E}\\x{200F}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{3164}\\x{FEFF}\\x{FFA0}]+)*$')
        && a.matches('.*[0-9A-Za-z\\x{00C0}-\\x{00D6}\\x{00D8}-\\x{00F6}\\x{00F8}-\\x{024F}].*');
    }
    function ibrFijos(d, r) {
      return d.esquema == r.esquema && d.modelo == r.modelo && d.actividad == r.actividad
        && d.equipo_ref == r.equipo_ref && d.creadoPor == r.creadoPor && d.creadoEn == r.creadoEn;
    }
    function ibrEmisionIgual(d, r) {
      return d.get('emitidoPor', null) == r.get('emitidoPor', null) && d.get('emitidoEn', null) == r.get('emitidoEn', null);
    }
    // Una firma estampada al emitir: es la del firmante escogido en ESA línea del contenido emitido
    // (misma clave y mismo nombre) y su imagen está en la carpeta de ESE firmante (Storage o Firestore).
    // Así nadie estampa la firma de otro escribiendo directo a la base.
    function ibrFirmaVersion(e, c) {
      return e is map && e.keys().hasOnly(['rol', 'clave', 'nombre', 'firma']) && e.keys().hasAll(['rol', 'clave', 'nombre', 'firma'])
        && e.rol in ['elaborado', 'revisado', 'aprobado']
        && e.clave is string && e.clave.matches('^f-[a-z0-9-]{1,38}$')
        && c.firmas[e.rol].firmante == e.clave
        && c.firmas[e.rol].nombre == e.nombre
        && e.firma is map && e.firma.keys().hasOnly(['almacen', 'ruta', 'huella', 'mime', 'ancho', 'alto'])
        && ibrHuella(e.firma.huella)
        && (e.firma.ruta == 'informes_brigada_marca/firmas/' + e.clave + '/' + e.firma.huella
          || e.firma.ruta == 'informes_brigada_bin/firma_' + e.clave + '_' + e.firma.huella[0:16]);
    }
    function ibrFirmasVersion(f, c) {
      return f is list && f.size() <= 3
        && (f.size() < 1 || ibrFirmaVersion(f[0], c))
        && (f.size() < 2 || (ibrFirmaVersion(f[1], c) && f[1].rol != f[0].rol))
        && (f.size() < 3 || (ibrFirmaVersion(f[2], c) && f[2].rol != f[0].rol && f[2].rol != f[1].rol));
    }

    match /informes_brigada_config/{doc} {
      allow get: if isTeamMember() && doc == 'general';
      allow list: if false;
      allow create, update: if doc == 'general' && hasProfile() && isAdmin()
        && request.resource.data.keys().hasOnly(['editores', 'contrato_defecto', 'almacen', 'firmantes', 'ingenieros', 'tecnicos', 'marca', 'actualizadoPor', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['editores', 'contrato_defecto', 'almacen', 'firmantes', 'marca', 'actualizadoPor', 'actualizadoEn'])
        && request.resource.data.editores is list && request.resource.data.editores.size() <= 10
        && request.resource.data.contrato_defecto is string && request.resource.data.contrato_defecto.size() <= 20
        && request.resource.data.almacen in ['storage', 'firestore']
        && request.resource.data.firmantes is list && request.resource.data.firmantes.size() <= 20
        // Personal de 2.2 (listas desplegables; 2026-10-15): opcionales, listas cortas de nombres.
        && request.resource.data.get('ingenieros', []) is list && request.resource.data.get('ingenieros', []).size() <= 30
        && request.resource.data.get('tecnicos', []) is list && request.resource.data.get('tecnicos', []).size() <= 30
        && request.resource.data.marca is map
        && ibrSello(request.resource.data);
      allow delete: if false;
    }

    match /informes_brigada/{id} {
      allow get: if isTeamMember();
      allow list: if isTeamMember() && request.query.limit <= 200;
      allow create: if ibrEditor()
        && request.resource.data.keys().hasOnly(ibrClaves())
        && request.resource.data.keys().hasAll(['esquema', 'modelo', 'actividad', 'equipo_ref', 'estado', 'version', 'rev',
                                                'contenido', 'creadoPor', 'creadoEn', 'actualizadoPor', 'actualizadoEn'])
        && request.resource.data.esquema == 'ibr@1'
        && request.resource.data.modelo == 'F60-REFRIG@1'
        && ibrActividad(request.resource.data.actividad)
        && ibrEquipoRef(request.resource.data.equipo_ref)
        && request.resource.data.estado == 'borrador' && request.resource.data.version == 0 && request.resource.data.rev == 1
        && request.resource.data.contenido is map
        && request.resource.data.get('anulacion', null) == null
        && !('emitidoPor' in request.resource.data) && !('emitidoEn' in request.resource.data)
        && ibrAutor(request.resource.data.creadoPor) && request.resource.data.creadoEn == request.time
        && ibrSello(request.resource.data);
      allow update: if resource.data.estado != 'anulado'
        && request.resource.data.keys().hasOnly(ibrClaves())
        && ibrFijos(request.resource.data, resource.data)
        && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.contenido is map
        && ibrSello(request.resource.data)
        && (
          // 1) guardar el borrador
          (ibrEditor() && resource.data.estado == 'borrador' && request.resource.data.estado == 'borrador'
            && request.resource.data.version == resource.data.version
            && ibrEmisionIgual(request.resource.data, resource.data)
            && request.resource.data.get('anulacion', null) == null)
          // 2) corregir un emitido: vuelve a borrador sin tocar contenido ni versión
          || (ibrEditor() && resource.data.estado == 'emitido' && request.resource.data.estado == 'borrador'
            && request.resource.data.version == resource.data.version
            && request.resource.data.contenido == resource.data.contenido
            && ibrEmisionIgual(request.resource.data, resource.data)
            && request.resource.data.get('anulacion', null) == null)
          // 3) emitir: versión + 1 con su copia congelada idéntica en la misma escritura
          || (ibrEditor() && resource.data.estado == 'borrador' && request.resource.data.estado == 'emitido'
            && request.resource.data.version == resource.data.version + 1
            && ibrAutor(request.resource.data.emitidoPor) && request.resource.data.emitidoEn == request.time
            && request.resource.data.get('anulacion', null) == null
            && existsAfter(ibrRutaVersion(id, string(request.resource.data.version)))
            && getAfter(ibrRutaVersion(id, string(request.resource.data.version))).data.contenido == request.resource.data.contenido)
          // 4) anular: solo un administrador con perfil; el contenido no cambia
          || (hasProfile() && isAdmin() && request.resource.data.estado == 'anulado'
            && request.resource.data.version == resource.data.version
            && request.resource.data.contenido == resource.data.contenido
            && ibrEmisionIgual(request.resource.data, resource.data)
            && request.resource.data.anulacion is map
            && request.resource.data.anulacion.keys().hasOnly(['motivo', 'por', 'en'])
            && request.resource.data.anulacion.keys().hasAll(['motivo', 'por', 'en'])
            && request.resource.data.anulacion.motivo is string
            && request.resource.data.anulacion.motivo.size() >= 10 && request.resource.data.anulacion.motivo.size() <= 500
            && ibrAutor(request.resource.data.anulacion.por)
            && request.resource.data.anulacion.en == request.time)
        );
      allow delete: if false;

      match /versiones/{n} {
        allow get: if isTeamMember();
        allow list: if isTeamMember() && request.query.limit <= 50;
        allow create: if ibrEditor()
          && n.matches('^[1-9][0-9]{0,3}$')
          && getAfter(ibrRutaInforme(id)).data.estado == 'emitido'
          && getAfter(ibrRutaInforme(id)).data.version == int(n)
          && get(ibrRutaInforme(id)).data.version == int(n) - 1
          && request.resource.data.keys().hasOnly(['version', 'contenido', 'huella', 'motivo', 'firmas', 'marca', 'emitidoPor', 'en'])
          && request.resource.data.keys().hasAll(['version', 'contenido', 'huella', 'motivo', 'firmas', 'marca', 'emitidoPor', 'en'])
          && request.resource.data.version == int(n)
          && request.resource.data.contenido == getAfter(ibrRutaInforme(id)).data.contenido
          && ibrHuella(request.resource.data.huella)
          && request.resource.data.motivo is string && request.resource.data.motivo.size() <= 500
          && (int(n) == 1 || request.resource.data.motivo.size() >= 10)
          && ibrFirmasVersion(request.resource.data.firmas, request.resource.data.contenido)
          && request.resource.data.marca is map
          && ibrAutor(request.resource.data.emitidoPor) && request.resource.data.en == request.time;
        allow update, delete: if false;
      }

      // Solo con almacen == 'firestore' (contingencia de L-29 / 99 §100). Una foto por documento.
      match /archivos/{a} {
        allow get: if isTeamMember();
        allow list: if false;
        allow create: if ibrEditor() && a.matches('^a[A-Za-z0-9]{20}$')
          && request.resource.data.keys().hasOnly(['bytes', 'mime', 'ancho', 'alto', 'tamano', 'huella', 'subidoPor', 'en'])
          && request.resource.data.keys().hasAll(['bytes', 'mime', 'ancho', 'alto', 'tamano', 'huella', 'subidoPor', 'en'])
          && request.resource.data.bytes is bytes
          && request.resource.data.bytes.size() >= 1 && request.resource.data.bytes.size() <= 700 * 1024
          && request.resource.data.tamano == request.resource.data.bytes.size()
          && request.resource.data.mime in ['image/jpeg', 'image/png']
          && request.resource.data.ancho is int && request.resource.data.ancho >= 1 && request.resource.data.ancho <= 4000
          && request.resource.data.alto is int && request.resource.data.alto >= 1 && request.resource.data.alto <= 4000
          && ibrHuella(request.resource.data.huella)
          && ibrAutor(request.resource.data.subidoPor) && request.resource.data.en == request.time
          && get(ibrRutaInforme(id)).data.estado == 'borrador';
        allow update: if false;
        // Solo de un borrador que nunca se emitió (un anulado queda congelado con sus fotos).
        allow delete: if ibrEditor() && get(ibrRutaInforme(id)).data.version == 0
          && get(ibrRutaInforme(id)).data.estado == 'borrador';
      }
    }

    // Biblioteca de fichas de fabricante (la comparten todos los informes).
    // La meta NUNCA lleva los bytes: así listar la biblioteca no baja imágenes.
    // Con almacen == 'firestore' los bytes van aparte en partes/0 (se suben
    // primero; la meta exige que existan, con la misma huella y tamaño).
    match /informes_brigada_fichas/{f} {
      allow get: if isTeamMember();
      allow list: if isTeamMember() && request.query.limit <= 100;
      allow create: if ibrEditor() && f.matches('^[a-z0-9_-]{3,80}$')
        && request.resource.data.keys().hasOnly(['titulo', 'marca', 'modelo', 'almacen', 'ruta', 'mime', 'ancho', 'alto',
                                                 'tamano', 'huella', 'subidoPor', 'en'])
        && request.resource.data.keys().hasAll(['titulo', 'marca', 'modelo', 'almacen', 'ruta', 'mime', 'ancho', 'alto',
                                                'tamano', 'huella', 'subidoPor', 'en'])
        && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 3 && request.resource.data.titulo.size() <= 120
        && request.resource.data.mime in ['image/jpeg', 'image/png']
        && request.resource.data.tamano is int && request.resource.data.tamano >= 1
        && ibrHuella(request.resource.data.huella)
        && ((request.resource.data.almacen == 'storage'
              && request.resource.data.ruta == 'informes_brigada_marca/fichas/' + f
              && request.resource.data.tamano <= 2 * 1024 * 1024)
          || (request.resource.data.almacen == 'firestore'
              && request.resource.data.ruta == 'informes_brigada_fichas/' + f + '/partes/0'
              && exists(ibrRutaParteFicha(f))
              && get(ibrRutaParteFicha(f)).data.huella == request.resource.data.huella
              && get(ibrRutaParteFicha(f)).data.bytes.size() == request.resource.data.tamano))
        && ibrAutor(request.resource.data.subidoPor) && request.resource.data.en == request.time;
      allow update: if false;
      allow delete: if false;   // nadie borra una ficha: las versiones emitidas la siguen usando

      match /partes/{p} {
        allow get: if isTeamMember();
        allow list: if false;
        allow create: if ibrEditor() && p == '0' && f.matches('^[a-z0-9_-]{3,80}$')
          && request.resource.data.keys().hasOnly(['bytes', 'mime', 'huella', 'subidoPor', 'en'])
          && request.resource.data.keys().hasAll(['bytes', 'mime', 'huella', 'subidoPor', 'en'])
          && request.resource.data.bytes is bytes
          && request.resource.data.bytes.size() >= 1 && request.resource.data.bytes.size() <= 900 * 1024
          && request.resource.data.mime in ['image/jpeg', 'image/png']
          && ibrHuella(request.resource.data.huella)
          && ibrAutor(request.resource.data.subidoPor) && request.resource.data.en == request.time;
        allow update: if false;
        allow delete: if false;   // las versiones emitidas siguen usando la ficha
      }
    }

    // Solo con almacen == 'firestore': logos (los lee el equipo) y firmas de terceros (solo editores).
    match /informes_brigada_bin/{b} {
      allow get: if (resource.data.clase == 'firma' && ibrEditor())
                 || (resource.data.clase == 'logo' && isTeamMember());
      allow list: if false;
      allow create: if hasProfile() && isAdmin()
        && b.matches('^(logo|firma)_[a-z0-9-]{2,40}_[0-9a-f]{16}$')
        && request.resource.data.keys().hasOnly(['clase', 'clave', 'bytes', 'mime', 'ancho', 'alto', 'tamano', 'huella',
                                                 'autorizacion', 'subidoPor', 'en'])
        && request.resource.data.keys().hasAll(['clase', 'clave', 'bytes', 'mime', 'ancho', 'alto', 'tamano', 'huella',
                                                'subidoPor', 'en'])
        && request.resource.data.clase in ['logo', 'firma']
        && b == request.resource.data.clase + '_' + request.resource.data.clave + '_' + request.resource.data.huella[0:16]
        && request.resource.data.bytes is bytes
        && request.resource.data.bytes.size() >= 1 && request.resource.data.bytes.size() <= 900 * 1024
        && request.resource.data.tamano == request.resource.data.bytes.size()
        && ibrHuella(request.resource.data.huella)
        && ((request.resource.data.clase == 'logo' && request.resource.data.mime in ['image/png', 'image/jpeg']
              && request.resource.data.clave in ['applus-encabezado', 'together-encabezado', 'applus-portada', 'together-portada', 'afinia-portada']
              && !('autorizacion' in request.resource.data))
          || (request.resource.data.clase == 'firma' && request.resource.data.mime == 'image/png'
              && request.resource.data.autorizacion is map
              && request.resource.data.autorizacion.keys().hasOnly(['fecha', 'medio'])
              && request.resource.data.autorizacion.keys().hasAll(['fecha', 'medio'])
              && request.resource.data.autorizacion.fecha is string
              && request.resource.data.autorizacion.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && request.resource.data.autorizacion.medio is string && request.resource.data.autorizacion.medio.size() >= 3))
        && ibrAutor(request.resource.data.subidoPor) && request.resource.data.en == request.time;
      allow update: if false;
      // Un logo no se borra (las versiones emitidas lo usan); una firma sí: el titular puede revocar su autorización.
      allow delete: if hasProfile() && isAdmin() && resource.data.clase == 'firma';
    }

    // ── Resto: cerrado por defecto ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
