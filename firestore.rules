rules_version = '2';

// ══════════════════════════════════════════════════════════════
// SGM · TRANSPOWER — Reglas Firestore (Fase 16 · schema v2)
// ──────────────────────────────────────────────────────────────
// Cambios respecto a F14:
//   · `transformadores` migra a shape v2: sección `identificacion`,
//     sección `ubicacion`, `estado_servicio` (enum ampliado con
//     'fallado'), `schema_version == 2`. Se mantiene compat con
//     el shape v1 aplanado (proyección v1) para que las vistas
//     legacy sigan funcionando; los `allow create`/`allow update`
//     aceptan payloads que traigan ambos niveles.
//   · Nueva colección `subestaciones`.
//   · Nuevas subcolecciones append-only `transformadores/{id}/
//     placas_historicas` y `transformadores/{id}/historial_hi`.
//   · Las escrituras siguen restringidas a `isAdmin()` mientras
//     F28 (RBAC granular con ámbito geográfico) entra.
//
// Referencia: MO.00418.DE-GAC-AX.01 Ed. 02 — §4.1 (variables), §4.2
// (ponderación HI), §A9 (protocolos).
// ══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers de sesión / rol ──
    function isSignedIn() { return request.auth != null; }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // ADR-079 (TODO-47a, decisión del Ingeniero 2026-09-20: «el administrador
    // soy yo»): el bootstrap legacy /admins es SOLO para el arranque, cuando
    // todavía no hay perfil. Si el usuario YA tiene perfil en /usuarios, su rol
    // sale de ahí y de ningún otro lado → degradar de admin a técnico revoca de
    // verdad. Antes bastaba con estar en /admins y activo, así que un degradado
    // seguía administrando TODO el backend (ADR-052 solo cerró el caso del
    // desactivado). El bootstrap puro (uid en /admins SIN perfil) se conserva:
    // sin él, borrar el perfil del único admin dejaría el proyecto sin nadie.
    function adminsBootstrapValido() {
      return !hasProfile()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isTeamMember() {
      return isSignedIn() && (
        (hasProfile() && profile().activo == true) ||
        adminsBootstrapValido()
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        (hasProfile() && profile().rol == 'admin' && profile().activo == true) ||
        adminsBootstrapValido()
      );
    }

    // ── Helpers de validación de enums v2 ──
    function isTipoActivoValido(v) {
      return v in ['POTENCIA', 'TPT', 'RESPALDO'];
    }
    function isEstadoServicioValido(v) {
      return v in ['operativo', 'mantenimiento', 'fuera_servicio', 'retirado', 'fallado'];
    }
    function isZonaValida(v) {
      return v in ['BOLIVAR', 'ORIENTE', 'OCCIDENTE'];
    }
    function isDeptoValido(v) {
      return v in ['bolivar', 'cordoba', 'sucre', 'cesar', 'magdalena'];
    }
    function isGrupoValido(v) {
      return v == '' || v == null || v in ['G1', 'G2', 'G3'];
    }

    // ── Helpers de validación de enums F38–F39 (suministros) ──
    function isTipoMovimientoValido(v) {
      return v in ['INGRESO', 'EGRESO'];
    }
    function isUnidadValida(v) {
      return v in ['Und', 'Lt', 'Kg', 'Mt', 'Gal', 'Otro'];
    }
    function isEstadoRepuestoValido(v) {
      return v in ['OPERATIVA', 'OBSOLETA', 'N/A'];
    }
    function isTipoCorreccionValido(v) {
      return v in ['matricula', 'tension', 'regulacion', 'stock', 'marca', 'otro'];
    }
    function isCodigoSuministroValido(v) {
      return v is string && v.matches('^S[0-9]{2}$');
    }
    function isCodigoMovimientoValido(v) {
      return v is string && v.matches('^MOV-[0-9]{4}-[0-9]{4}$');
    }
    function isContratoIdValido(v) {
      return v is string && v.matches('^[0-9]{8,14}$');
    }
    // Acepta docId legacy (id == codigo) y docId multi-contrato
    // ({contrato_id}_{codigo}) introducido en N3-N5. La parte
    // tras el "_" debe ser exactamente el codigo del payload.
    function isSuministroDocId(id, codigo) {
      return id == codigo
          || (id.matches('^[0-9]{8,14}_S[0-9]{2}$') && id.split('_')[1] == codigo);
    }

    // ── /admins/{uid} — legacy bootstrap (F5) ──
    match /admins/{uid} {
      allow read:  if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── /usuarios/{uid} — perfiles (F14) ──
    // F28 extenderá a los 5 roles oficiales (director_proyectos,
    // analista_tx, gestor_contractual, brigadista, auditor_campo).
    // En F16 se mantiene la lista v1 + aceptación del rol legacy
    // 'tecnico' (los perfiles actuales no rompen).
    match /usuarios/{uid} {
      allow get:    if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list:   if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll([
                        'email','rol','activo'
                       ])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.rol in [
                        'admin','tecnico',
                        'director_proyectos','analista_tx',
                        'gestor_contractual','brigadista','auditor_campo'
                       ]
                    && request.resource.data.activo is bool;
      allow update: if isAdmin()
                    && (!('rol' in request.resource.data)
                        || request.resource.data.rol in [
                            'admin','tecnico',
                            'director_proyectos','analista_tx',
                            'gestor_contractual','brigadista','auditor_campo'
                           ])
                    && (!('activo' in request.resource.data)
                        || request.resource.data.activo is bool);
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // ── /subestaciones/{id} (Fase 16) ──
    // La UI dedicada entra en F20. F16 sólo expone CRUD admin
    // para que el importador F17 pueda poblar la colección.
    match /subestaciones/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll([
                        'codigo','nombre','departamento'
                       ])
                    && request.resource.data.codigo is string
                    && request.resource.data.codigo.size() > 0
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0
                    && isDeptoValido(request.resource.data.departamento)
                    && (!('zona' in request.resource.data)
                        || request.resource.data.zona == ''
                        || isZonaValida(request.resource.data.zona));
      allow update: if isAdmin()
                    && (!('departamento' in request.resource.data)
                        || isDeptoValido(request.resource.data.departamento))
                    && (!('zona' in request.resource.data)
                        || request.resource.data.zona == ''
                        || isZonaValida(request.resource.data.zona));
      allow delete: if isAdmin();
    }

    // ── /transformadores/{id} — schema v2 ──
    // Shape aceptado:
    //   schema_version: 2
    //   estado_servicio: enum
    //   identificacion: { codigo, nombre, tipo_activo, uucc?, grupo? }
    //   ubicacion: { departamento, zona?, ... }
    //   placa, electrico, mecanico, refrigeracion, protecciones,
    //   fabricacion, servicio, salud_actual, criticidad
    //
    // Además se permiten campos de proyección v1 en el nivel raíz
    // (codigo, nombre, departamento, estado, ...) para compat con
    // vistas legacy que todavía consultan por ellos. Las rules
    // validan AMBOS niveles como coherentes cuando el payload
    // trae los dos.
    match /transformadores/{id} {

      allow read: if isTeamMember();

      allow create: if isAdmin()
        && request.resource.data.schema_version == 2
        && request.resource.data.keys().hasAll(['identificacion','ubicacion','estado_servicio'])
        && request.resource.data.identificacion.keys().hasAll(['codigo','nombre','tipo_activo'])
        && request.resource.data.identificacion.codigo is string
        && request.resource.data.identificacion.codigo.size() > 0
        && request.resource.data.identificacion.nombre is string
        && request.resource.data.identificacion.nombre.size() > 0
        && isTipoActivoValido(request.resource.data.identificacion.tipo_activo)
        && isGrupoValido(request.resource.data.identificacion.get('grupo', ''))
        && isDeptoValido(request.resource.data.ubicacion.departamento)
        && (!('zona' in request.resource.data.ubicacion)
            || request.resource.data.ubicacion.zona == ''
            || isZonaValida(request.resource.data.ubicacion.zona))
        && isEstadoServicioValido(request.resource.data.estado_servicio)
        // Proyección v1 (si está presente) debe ser consistente.
        && (!('codigo' in request.resource.data)
            || request.resource.data.codigo == request.resource.data.identificacion.codigo)
        && (!('estado' in request.resource.data)
            || request.resource.data.estado == request.resource.data.estado_servicio
            || (request.resource.data.estado_servicio == 'fallado'
                && request.resource.data.estado == 'retirado'))
        // F41 · sub-section repuesto opcional. Si está, valida enum.
        && (!('repuesto' in request.resource.data)
            || !('estado' in request.resource.data.repuesto)
            || isEstadoRepuestoValido(request.resource.data.repuesto.estado));

      allow update: if isAdmin()
        && (!('schema_version' in request.resource.data)
            || request.resource.data.schema_version == 2)
        && (!('estado_servicio' in request.resource.data)
            || isEstadoServicioValido(request.resource.data.estado_servicio))
        && (!('identificacion' in request.resource.data)
            || !('tipo_activo' in request.resource.data.identificacion)
            || isTipoActivoValido(request.resource.data.identificacion.tipo_activo))
        && (!('identificacion' in request.resource.data)
            || !('grupo' in request.resource.data.identificacion)
            || isGrupoValido(request.resource.data.identificacion.grupo))
        && (!('ubicacion' in request.resource.data)
            || !('departamento' in request.resource.data.ubicacion)
            || isDeptoValido(request.resource.data.ubicacion.departamento))
        && (!('ubicacion' in request.resource.data)
            || !('zona' in request.resource.data.ubicacion)
            || request.resource.data.ubicacion.zona == ''
            || isZonaValida(request.resource.data.ubicacion.zona))
        // F41 · sub-section repuesto opcional. Si está, valida enum.
        && (!('repuesto' in request.resource.data)
            || !('estado' in request.resource.data.repuesto)
            || isEstadoRepuestoValido(request.resource.data.repuesto.estado));

      allow delete: if isAdmin();

      // ── /transformadores/{id}/placas_historicas/{evt} ──
      // Append-only: trazabilidad de retrofits. F16 reserva el
      // shape; la UI para registrar cambios entra en F23.
      match /placas_historicas/{evt} {
        allow read:   if isTeamMember();
        allow create: if isAdmin()
                      && request.resource.data.tipo_cambio in [
                          'potencia','tension','refrigeracion','tap','otro'
                         ];
        allow update: if false;
        allow delete: if false;
      }

      // ── /transformadores/{id}/historial_hi/{calculo} ──
      // Append-only: snapshots del Health Index. Cada re-cálculo
      // del motor (F18) o cambio de umbrales genera una entrada.
      match /historial_hi/{calculo} {
        allow read:   if isTeamMember();
        allow create: if isAdmin()
                      && request.resource.data.trigger in [
                          'muestra_nueva','parametros_actualizados',
                          'migracion_v2','manual','override_experto',
                          'recalculo_masivo'
                         ];
        allow update: if false;
        allow delete: if false;
      }

      // ── /transformadores/{id}/historial/{evt} (legacy de F7) ──
      // Se mantiene por compat con órdenes viejas. El mismo alias
      // de subcolección no existe; este match es defensivo.
      match /historial/{evt} {
        allow read:   if isTeamMember();
        allow create: if isAdmin();
        allow update: if false;
        allow delete: if false;
      }
    }

    // ── /ordenes/{id} (sin cambios en F16, migra en F23) ──
    match /ordenes/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll([
                        'codigo','titulo','transformadorId',
                        'estado','tipo','prioridad'
                       ])
                    && request.resource.data.codigo is string
                    && request.resource.data.codigo.size() > 0
                    && request.resource.data.estado in [
                        'planificada','en_curso','cerrada','cancelada'
                       ]
                    && request.resource.data.tipo in [
                        'preventivo','correctivo','predictivo','emergencia',
                        'etu','reemplazo','retiro'
                       ]
                    && request.resource.data.prioridad in [
                        'baja','media','alta','critica'
                       ]
                    // v2: si estado_v2 viene, debe ser válido (F23)
                    && (!('estado_v2' in request.resource.data)
                        || request.resource.data.estado_v2 in [
                            'borrador','propuesta','revisada','autorizada',
                            'programada','en_ejecucion','ejecutada','verificada',
                            'cerrada','rechazada','cancelada'
                           ]);
      allow update: if isAdmin()
                    && request.resource.data.estado in [
                        'planificada','en_curso','cerrada','cancelada'
                       ]
                    && request.resource.data.tipo in [
                        'preventivo','correctivo','predictivo','emergencia',
                        'etu','reemplazo','retiro'
                       ]
                    && request.resource.data.prioridad in [
                        'baja','media','alta','critica'
                       ]
                    && (!('estado_v2' in request.resource.data)
                        || request.resource.data.estado_v2 in [
                            'borrador','propuesta','revisada','autorizada',
                            'programada','en_ejecucion','ejecutada','verificada',
                            'cerrada','rechazada','cancelada'
                           ]);
      allow delete: if isAdmin();

      match /historial/{evt} {
        allow read:   if isTeamMember();
        allow create: if isAdmin();
        allow update: if false;
        allow delete: if false;
      }
    }

    // ── /documentos/{id} (sin cambios en F16) ──
    match /documentos/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll([
                        'codigo','titulo','categoria','norma_aplicable'
                       ])
                    && request.resource.data.codigo is string
                    && request.resource.data.codigo.size() > 0
                    && request.resource.data.categoria in [
                        'protocolo','informe','certificado','manual','reporte','otro'
                       ]
                    && request.resource.data.norma_aplicable in [
                        'ISO_50001','IEEE_C57_12','IEC_60076',
                        'RETIE','NTC_IEC_60364','CIGRE_WG_A2','NINGUNA'
                       ];
      allow update: if isAdmin()
                    && request.resource.data.categoria in [
                        'protocolo','informe','certificado','manual','reporte','otro'
                       ]
                    && request.resource.data.norma_aplicable in [
                        'ISO_50001','IEEE_C57_12','IEC_60076',
                        'RETIE','NTC_IEC_60364','CIGRE_WG_A2','NINGUNA'
                       ];
      allow delete: if isAdmin();
    }

    match /alertas_config/{id} {
      allow read:   if isTeamMember();
      allow write:  if isAdmin();
    }

    // ── /umbrales_salud/{id} (Fase 18) ──
    // Documento `global` con los umbrales activos del motor de
    // salud. Historial append-only en /historial/{id}.
    match /umbrales_salud/{id} {
      allow read:   if isTeamMember();
      allow write:  if isAdmin();
      match /historial/{evt} {
        allow read:   if isTeamMember();
        allow create: if isAdmin();
        allow update: if false;
        allow delete: if false;
      }
    }

    // ── /contramuestras/{id} (F26) ──
    match /contramuestras/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── /monitoreo_intensivo/{id} (F18/F26 · A9.1) ──
    match /monitoreo_intensivo/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.transformadorId is string
                    && request.resource.data.tipo == 'C2H2';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── /auditoria/{id} (F35) ──
    match /auditoria/{id} {
      allow read:   if isAdmin() || (hasProfile() && profile().rol == 'auditor_campo');
      // G002 (ADR-052 Ola 1): antes cualquier autenticado (incl. desactivado)
      // podía escribir el log. Ahora exige miembro ACTIVO. append-only intacto.
      allow create: if isTeamMember()
                    && request.resource.data.accion is string;
      allow update: if false;
      allow delete: if false;
    }

    // ── /fallados/{id} (F25) ──
    match /fallados/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.transformadorId is string
                    && request.resource.data.tipo_falla in
                       ['termica','electrica','mecanica','quimica','externa','desconocida']
                    && request.resource.data.metodo_rca in
                       ['5_porques','ishikawa','fmea'];
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── /parametros_sistema/{id} (F36) ──
    match /parametros_sistema/{id} {
      allow read:   if isTeamMember();
      allow write:  if isAdmin();
    }

    // ── /contratos/{id} (F21) ──
    match /contratos/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.codigo is string
                    && request.resource.data.codigo.size() > 0
                    && request.resource.data.estado in
                       ['vigente','suspendido','finalizado','en_liquidacion'];
      allow update: if isAdmin()
                    && request.resource.data.estado in
                       ['vigente','suspendido','finalizado','en_liquidacion'];
      allow delete: if isAdmin();
    }

    // ── /subactividades, /macroactividades, /causantes (F22) ──
    match /subactividades/{id} {
      allow read:   if isTeamMember();
      allow write:  if isAdmin();
    }
    match /macroactividades/{id} {
      allow read:   if isTeamMember();
      allow write:  if isAdmin();
    }
    match /causantes/{id} {
      allow read:   if isTeamMember();
      allow write:  if isAdmin();
    }

    // ── /muestras/{id} (Fase 19) ──
    // Time-series DGA/ADFQ/FUR. Read team, Create/Update admin
    // con validación de enum tipo. Delete solo admin.
    match /muestras/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.transformadorId is string
                    && request.resource.data.tipo in ['DGA','ADFQ','FURANOS','COMBO']
                    && request.resource.data.fecha_muestra is string;
      allow update: if isAdmin()
                    && (!('tipo' in request.resource.data)
                        || request.resource.data.tipo in ['DGA','ADFQ','FURANOS','COMBO']);
      allow delete: if isAdmin();
    }

    // ── /importaciones/{id} (Fase 17) ──
    // Log append-only de jobs de importación Excel. Cada job
    // lleva el reporte de discrepancias Excel ↔ MO.00418.
    match /importaciones/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // ── /propuestas_reclasificacion_fur/{id} (F18/F26 · A9.2) ──
    match /propuestas_reclasificacion_fur/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.transformadorId is string
                    && request.resource.data.estado == 'pendiente_revision_experto'
                    && request.resource.data.referencia_normativa is string;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /alertas_reconocidas/{id} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.alertId is string
                    && request.resource.data.alertId.size() > 0;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Gate legacy F12 cerrado ──
    match /gate_codes/{hash} {
      allow read, write: if false;
    }

    // ══════════════════════════════════════════════════════════
    // F40 · Suministros / Repuestos / Stock
    // ══════════════════════════════════════════════════════════

    // ── /suministros/{id} ──
    // docId acepta dos formas (decisión N3-N5):
    //   · legacy:        id == codigo                  (1 contrato)
    //   · multi-contrato: id == "{contrato_id}_{codigo}" (N contratos)
    // En ambos casos la parte humana (codigo) es Sxx.
    match /suministros/{id} {
      allow read: if isTeamMember();
      allow create: if isAdmin()
                    && isCodigoSuministroValido(request.resource.data.codigo)
                    && isSuministroDocId(id, request.resource.data.codigo)
                    && (!('contrato_id' in request.resource.data)
                        || request.resource.data.contrato_id == ''
                        || isContratoIdValido(request.resource.data.contrato_id))
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0
                    && isUnidadValida(request.resource.data.unidad)
                    && request.resource.data.stock_inicial is number
                    && request.resource.data.stock_inicial >= 0
                    && request.resource.data.valor_unitario is number
                    && request.resource.data.valor_unitario >= 0;
      allow update: if isAdmin()
                    // Codigo es inmutable (PK humana).
                    && (!('codigo' in request.resource.data)
                        || request.resource.data.codigo == resource.data.codigo)
                    && (!('unidad' in request.resource.data)
                        || isUnidadValida(request.resource.data.unidad))
                    && (!('stock_inicial' in request.resource.data)
                        || (request.resource.data.stock_inicial is number
                            && request.resource.data.stock_inicial >= 0));
      allow delete: if isAdmin();
    }

    // ── /marcas/{id} ──
    // docId auto-generado (collection().doc()). contrato_id opcional
    // (legacy) o presente (N3-N5 multi-contrato).
    match /marcas/{id} {
      allow read: if isTeamMember();
      allow create: if isAdmin()
                    && isCodigoSuministroValido(request.resource.data.suministro_id)
                    && (!('contrato_id' in request.resource.data)
                        || request.resource.data.contrato_id == ''
                        || isContratoIdValido(request.resource.data.contrato_id))
                    && request.resource.data.marca is string
                    && request.resource.data.marca.size() > 0;
      allow update: if isAdmin()
                    && (!('suministro_id' in request.resource.data)
                        || isCodigoSuministroValido(request.resource.data.suministro_id))
                    && (!('marca' in request.resource.data)
                        || (request.resource.data.marca is string
                            && request.resource.data.marca.size() > 0));
      allow delete: if isAdmin();
    }

    // ── /movimientos/{id} ──
    // Decisión 6·A del plan: WRITE solo admin. Tecnico/brigadista no
    // crean movimientos. La aplicación cliente envuelve crear() en
    // runTransaction (F39); aquí validamos invariantes server-side.
    match /movimientos/{id} {
      allow read: if isTeamMember();
      allow create: if isAdmin()
                    && isCodigoMovimientoValido(request.resource.data.codigo)
                    && isTipoMovimientoValido(request.resource.data.tipo)
                    && isCodigoSuministroValido(request.resource.data.suministro_id)
                    && (!('contrato_id' in request.resource.data)
                        || request.resource.data.contrato_id == ''
                        || isContratoIdValido(request.resource.data.contrato_id))
                    && request.resource.data.cantidad is int
                    && request.resource.data.cantidad >= 1
                    && request.resource.data.transformador_id is string
                    && request.resource.data.transformador_id.size() > 0
                    && request.resource.data.matricula is string
                    && request.resource.data.matricula.size() > 0
                    && request.resource.data.anio is int
                    && request.resource.data.anio >= 2000
                    && request.resource.data.anio <= 2100
                    && request.resource.data.valor_total is number
                    && request.resource.data.valor_total >= 0;
      // Update permitido solo para corregir typos de campos no críticos
      // (observaciones, odt). Codigo, tipo, cantidad, suministro_id,
      // transformador_id NO se pueden cambiar — para corregir un
      // movimiento se elimina (con justificación) y se crea otro.
      allow update: if isAdmin()
                    && request.resource.data.codigo == resource.data.codigo
                    && request.resource.data.tipo == resource.data.tipo
                    && request.resource.data.cantidad == resource.data.cantidad
                    && request.resource.data.suministro_id == resource.data.suministro_id
                    && request.resource.data.transformador_id == resource.data.transformador_id;
      allow delete: if isAdmin();
    }

    // ── /correcciones/{id} ──
    // Append + update permitidos. Delete BLOQUEADO (traceability
    // inmutable, regla del skill asset-tracking-system).
    match /correcciones/{id} {
      allow read: if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.numero is int
                    && request.resource.data.numero >= 1
                    && isTipoCorreccionValido(request.resource.data.tipo)
                    && (!('contrato_id' in request.resource.data)
                        || request.resource.data.contrato_id == ''
                        || isContratoIdValido(request.resource.data.contrato_id))
                    && request.resource.data.ubicacion is string
                    && request.resource.data.ubicacion.size() > 0
                    && request.resource.data.justificacion is string
                    && request.resource.data.justificacion.size() > 0;
      allow update: if isAdmin()
                    && (!('tipo' in request.resource.data)
                        || isTipoCorreccionValido(request.resource.data.tipo));
      allow delete: if false;
    }

    // ── /suministros_config/{id} ──
    // Singleton /suministros_config/global con permitirNegativo y umbrales.
    match /suministros_config/{id} {
      allow read: if isTeamMember();
      allow write: if isAdmin();
    }

    // ── /acciones_refrigeracion/{id} ──
    // Acciones de mantenimiento del sistema de refrigeración
    // generadas desde el módulo Mantenimiento Brigada (Selección
    // ONAF · mix multi-modelo). Cada documento es un snapshot
    // completo del cálculo + datos del responsable + estado del
    // workflow. Lectura por todo el equipo; creación / update /
    // delete por admin (los brigadistas envían la acción al admin
    // para registro en una sesión posterior). El transformador
    // referenciado no se puede cambiar después de creado el doc.
    match /acciones_refrigeracion/{id} {
      allow read: if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.transformador_id is string
                    && request.resource.data.transformador_id.size() > 0
                    && request.resource.data.matricula is string
                    && request.resource.data.matricula.size() > 0
                    && request.resource.data.accion_descripcion is string
                    && request.resource.data.accion_descripcion.size() >= 10
                    && request.resource.data.estado_accion in
                       ['planificada', 'pendiente_aprobacion', 'aprobada', 'ejecutada', 'cancelada']
                    && request.resource.data.mix is list
                    && request.resource.data.mix.size() >= 1
                    && request.resource.data.fecha_accion is string
                    && request.resource.data.fecha_accion.size() > 0;
      allow update: if isAdmin()
                    && (!('estado_accion' in request.resource.data)
                        || request.resource.data.estado_accion in
                           ['planificada', 'pendiente_aprobacion', 'aprobada', 'ejecutada', 'cancelada'])
                    && request.resource.data.transformador_id == resource.data.transformador_id;
      allow delete: if isAdmin();
    }

    // ── Pruebas Eléctricas (Mantenimiento Predictivo) ──
    // Unidad = transformador con su ficha de identidad; subcolección
    // `informes` = un doc por año/ensayo con el resumen escalar de cada
    // prueba (tand[] + excitacion/relacion/resistencia/aislamiento/collar)
    // y el PDF original en Storage. Lectura para el equipo, escritura admin.
    match /pruebas_electricas/{id} {
      allow read: if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.data.serie is string
                    && request.resource.data.serie.size() > 0;
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /informes/{informeId} {
        allow read: if isTeamMember();
        allow create: if isAdmin()
                      && request.resource.data.ano is number;
        allow update: if isAdmin();
        allow delete: if isAdmin();

        // Diagnóstico de extracción (ADR-007): bloques + interpretación cruda
        // de la IA. Subcolección perezosa (no se lee en la suscripción viva).
        // Las reglas NO cascadean → match explícito. Lectura para el equipo,
        // escritura solo admin.
        match /diagnostico/{d} {
          allow read: if isTeamMember();
          allow create, update: if isAdmin();
          allow delete: if isAdmin();
        }
      }
    }

    // ── Órdenes de Materiales: registro del equipo de OE/OS (99 §77) ──
    // La PRIMERA colección donde escribe un técnico (decisión del Ingeniero:
    // guardan y editan todos los miembros activos; borra quien la creó o un
    // admin). Espejo de `assets/js/domain/ordenes_registro.js` (LIMITES,
    // RE_NUMERO): si cambian allá, cambian aquí y en tests-rules/.
    //  · la clave SALE del tipo y el número: nadie guarda dos veces la misma
    //    orden ni esconde una orden bajo la clave de otra;
    //  · personas SOLO con nombre (sin cédulas); autoría = quien escribe, con
    //    el nombre de su perfil; sellos del servidor; versión +1 al editar;
    //  · borrar exige dejar en la MISMA escritura la lápida con la copia
    //    exacta de lo borrado (recuperación, y freno a que una copia vieja de
    //    un navegador la resucite);
    //  · límite: el INTERIOR de cada ítem no se valida aquí (las reglas no
    //    recorren listas); lo limpia el cliente.
    match /ordenes_materiales/{clave} {
      function omTexto(d, k, max) {
        return !(k in d) || (d[k] is string && d[k].size() <= max);
      }
      function omPersona(p) {
        return p is map && p.keys().hasOnly(['nombre'])
          && p.get('nombre', '') is string && p.get('nombre', '').size() <= 120;
      }
      function omAutor(a) {
        return a is map && a.keys().hasOnly(['uid', 'nombre'])
          && a.uid == request.auth.uid
          && a.nombre == profile().get('nombre', '');
      }
      function omValida(d) {
        return d.keys().hasOnly(['clave', 'tipo', 'numero', 'zona', 'fechaISO', 'fecha', 'hora',
                                 'origen', 'destino', 'items', 'transformador', 'motivo', 'motivoSel',
                                 'nota', 'autorizado', 'entregado', 'recibido', 'empresaVig',
                                 'conFirmas', 'creadoPor', 'creadoEn', 'actualizadoPor',
                                 'actualizadoEn', 'version', 'migradaDe', 'elaboradaEn'])
          && d.keys().hasAll(['clave', 'tipo', 'numero', 'fechaISO', 'items', 'autorizado',
                              'entregado', 'recibido', 'creadoPor', 'creadoEn', 'actualizadoPor',
                              'actualizadoEn', 'version'])
          && d.tipo in ['ENTRADA', 'SALIDA']
          && d.numero is string && d.numero.matches('^[A-Z0-9][A-Z0-9 ._/-]{0,29}$')
          && d.clave == clave
          && clave == d.tipo + '_' + d.numero.replace('/', '~')
          && d.fechaISO is string && d.fechaISO.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.items is list && d.items.size() >= 1 && d.items.size() <= 200
          && omPersona(d.autorizado) && omPersona(d.entregado) && omPersona(d.recibido)
          && omTexto(d, 'zona', 60) && omTexto(d, 'fecha', 60) && omTexto(d, 'hora', 20)
          && omTexto(d, 'origen', 160) && omTexto(d, 'destino', 160)
          && omTexto(d, 'transformador', 200) && omTexto(d, 'motivo', 500)
          && omTexto(d, 'motivoSel', 500) && omTexto(d, 'nota', 500)
          && omTexto(d, 'empresaVig', 100) && omTexto(d, 'elaboradaEn', 40)
          && (!('conFirmas' in d) || d.conFirmas is bool)
          && (!('migradaDe' in d) || d.migradaDe in ['navegador', 'pendiente'])
          && d.version is int
          && omAutor(d.actualizadoPor) && d.actualizadoEn == request.time;
      }
      function omLapida() {
        return /databases/$(database)/documents/ordenes_materiales_borradas/$(clave);
      }

      allow get:    if isTeamMember();
      allow list:   if isTeamMember() && request.query.limit <= 501;
      allow create: if isTeamMember() && hasProfile()
                    && omValida(request.resource.data)
                    && omAutor(request.resource.data.creadoPor)
                    && request.resource.data.creadoEn == request.time
                    && request.resource.data.version == 1;
      allow update: if isTeamMember() && hasProfile()
                    && omValida(request.resource.data)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['clave', 'tipo', 'numero', 'creadoPor', 'creadoEn',
                                  'migradaDe', 'elaboradaEn'])
                    && request.resource.data.version == resource.data.version + 1;
      allow delete: if isTeamMember() && hasProfile()
                    && (isAdmin() || resource.data.creadoPor.uid == request.auth.uid)
                    && existsAfter(omLapida())
                    && getAfter(omLapida()).data.borradaEn == request.time;
    }

    // Lápida de una orden borrada: solo nace en la MISMA escritura que borra la
    // orden, la escribe quien puede borrarla y guarda la copia EXACTA.
    match /ordenes_materiales_borradas/{clave} {
      function omOrden() {
        return /databases/$(database)/documents/ordenes_materiales/$(clave);
      }
      allow get:    if isTeamMember();
      allow list:   if false;
      allow create, update: if isTeamMember() && hasProfile()
                    && exists(omOrden()) && !existsAfter(omOrden())
                    && (isAdmin() || get(omOrden()).data.creadoPor.uid == request.auth.uid)
                    && request.resource.data.keys().hasOnly(['clave', 'borradaPor', 'borradaEn', 'orden'])
                    && request.resource.data.clave == clave
                    && request.resource.data.borradaPor is map
                    && request.resource.data.borradaPor.keys().hasOnly(['uid', 'nombre'])
                    && request.resource.data.borradaPor.uid == request.auth.uid
                    && request.resource.data.borradaPor.nombre == profile().get('nombre', '')
                    && request.resource.data.borradaEn == request.time
                    && request.resource.data.orden == get(omOrden()).data;
      allow delete: if false;
    }

    // ── Cédulas de los responsables de las Órdenes de Materiales (99 §78) ──
    // El repositorio es público: las cédulas no pueden ir en el código. Aquí
    // las lee el equipo activo UNA a UNA (get por nombre, al generar el
    // documento); listar el directorio completo y escribir, solo el admin.
    // El id sale del nombre (todos los espacios → «_», Ñ incluida) y la
    // escritura exige declarar la autorización de la persona (Ley 1581).
    // Espejo de `assets/js/domain/responsables_ordenes.js`.
    // ── Firmas del EQUIPO · registros que SOLO se agregan (ADR-099) ──
    // Trazabilidad interna elegida por el Ingeniero: nadie edita ni borra.
    //   · firmas_equipo_registro: alta / reemplazo / retiro de cada firma, con la
    //     autorización declarada y la huella de la imagen.
    //   · fichas_emisiones: cada Excel emitido con firmas del equipo: equipo,
    //     casillas con su origen y huella, y la huella del archivo.
    function personaDelEquipo(p) {
      return p in ['MIGUEL_JIMENEZ', 'CARLOS_MARTELO', 'JORGE_RHENALS', 'JORGE_MIRANDA', 'ERICK_VERGARA'];
    }
    match /firmas_equipo_registro/{id} {
      // get y list, ambos SOLO del custodio: otro admin no ve a quién custodia
      // ni con qué autorización (revisión de ADR-099).
      allow get:  if isAdmin() && resource.data.custodio == request.auth.uid;
      allow list: if isAdmin() && request.query.limit <= 50 && resource.data.custodio == request.auth.uid;
      allow create: if isAdmin() && hasProfile()
                    && request.resource.data.keys().hasOnly(['tipo', 'persona', 'autorizacion', 'huella',
                                                             'custodio', 'custodioNombre', 'en'])
                    && request.resource.data.keys().hasAll(['tipo', 'persona', 'custodio', 'custodioNombre', 'en'])
                    && request.resource.data.tipo in ['alta', 'reemplazo', 'retiro']
                    && personaDelEquipo(request.resource.data.persona)
                    && request.resource.data.custodio == request.auth.uid
                    && request.resource.data.custodioNombre == profile().get('nombre', '')
                    && request.resource.data.en == request.time
                    && (request.resource.data.tipo == 'retiro'
                        || (request.resource.data.autorizacion is map
                            && request.resource.data.autorizacion.keys().hasOnly(['fecha', 'medio'])
                            && request.resource.data.autorizacion.fecha is string
                            && request.resource.data.autorizacion.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                            && request.resource.data.autorizacion.medio is string
                            && request.resource.data.autorizacion.medio.size() >= 3
                            && request.resource.data.autorizacion.medio.size() <= 200
                            && request.resource.data.huella is string
                            && request.resource.data.huella.matches('^[0-9a-f]{64}$')));
      allow update, delete: if false;
    }
    match /fichas_emisiones/{folio} {
      allow get:  if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 50;
      allow create: if isAdmin() && hasProfile()
                    && request.resource.data.keys().hasOnly(['equipo', 'documento', 'casillas', 'huellaArchivo',
                                                             'custodio', 'custodioNombre', 'en'])
                    && request.resource.data.keys().hasAll(['equipo', 'documento', 'casillas', 'huellaArchivo',
                                                            'custodio', 'custodioNombre', 'en'])
                    && request.resource.data.equipo is map
                    && request.resource.data.equipo.keys().hasOnly(['matricula', 'subestacion', 'serie'])
                    && request.resource.data.documento == 'PE.02081'
                    && request.resource.data.casillas is list
                    && request.resource.data.casillas.size() >= 1
                    && request.resource.data.casillas.size() <= 5
                    && request.resource.data.huellaArchivo is string
                    && request.resource.data.huellaArchivo.matches('^[0-9a-f]{64}$')
                    && request.resource.data.custodio == request.auth.uid
                    && request.resource.data.custodioNombre == profile().get('nombre', '')
                    && request.resource.data.en == request.time;
      allow update, delete: if false;
    }

    match /responsables_ordenes/{id} {
      allow get:  if isTeamMember();
      allow list: if isTeamMember() && isAdmin() && request.query.limit <= 50;
      allow create, update: if isTeamMember() && isAdmin() && hasProfile()
                    && request.resource.data.keys().hasOnly(['nombre', 'cedula', 'autorizacion',
                                                             'actualizadoPor', 'actualizadoEn'])
                    && request.resource.data.keys().hasAll(['nombre', 'cedula', 'autorizacion',
                                                            'actualizadoPor', 'actualizadoEn'])
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() <= 80
                    && request.resource.data.nombre.matches('^[A-ZÑ]+( [A-ZÑ]+)*$')
                    && id == request.resource.data.nombre.replace(' ', '_')
                    && request.resource.data.cedula is string
                    && request.resource.data.cedula.matches('^[0-9]{5,12}$')
                    && request.resource.data.autorizacion is map
                    && request.resource.data.autorizacion.keys().hasOnly(['fecha', 'medio'])
                    && request.resource.data.autorizacion.fecha is string
                    && request.resource.data.autorizacion.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.autorizacion.medio is string
                    && request.resource.data.autorizacion.medio.size() >= 3
                    && request.resource.data.autorizacion.medio.size() <= 120
                    && request.resource.data.actualizadoPor is map
                    && request.resource.data.actualizadoPor.keys().hasOnly(['uid', 'nombre'])
                    && request.resource.data.actualizadoPor.uid == request.auth.uid
                    && request.resource.data.actualizadoPor.nombre == profile().get('nombre', '')
                    && request.resource.data.actualizadoEn == request.time;
      allow delete: if isTeamMember() && isAdmin();
    }

    // ── Resto: cerrado por defecto ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
