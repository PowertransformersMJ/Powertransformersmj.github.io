rules_version = '2';

// ══════════════════════════════════════════════════════════════
// SGM · TRANSPOWER — Reglas Firebase Storage (Fase 9)
// Gestión documental. Criterio ÚNICO alineado con `firestore.rules`:
//   · LECTURA  → miembro ACTIVO del equipo (`isTeamMember`), no
//     "cualquier cuenta autenticada". Un usuario desactivado pierde
//     los PDFs igual que pierde los datos en Firestore.
//   · ESCRITURA → solo admin (`isAdmin`), con tope de tamaño por ruta.
//   · Todo lo no declarado queda cerrado.
// ══════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helpers ──
    function isSignedIn() {
      return request.auth != null;
    }

    // Espejo EXACTO de los helpers de `firestore.rules` (§ "Helpers de
    // sesión / rol"). Storage y Firestore deben responder lo mismo a la
    // pregunta "¿quién es este usuario?": si divergen, los PDFs quedan
    // más abiertos que los datos que describen.
    function hasProfile() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid));
    }

    function profile() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Bootstrap legacy /admins: SOLO para el arranque, cuando aún no hay
    // perfil. Con perfil, el rol sale de /usuarios y de ningún otro lado
    // (ADR-079, mismo criterio que firestore.rules): un ex-admin degradado a
    // técnico deja de escribir aquí, aunque siga en /admins.
    function adminsBootstrapValido() {
      return !hasProfile()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Miembro ACTIVO del equipo: perfil en /usuarios con activo == true, o
    // bootstrap válido. Es el criterio de lectura de todo el bucket.
    function isTeamMember() {
      return isSignedIn() && (
        (hasProfile() && profile().activo == true) ||
        adminsBootstrapValido()
      );
    }

    // G005 (ADR-052 Ola 1): reconoce a los admins v2 (/usuarios rol='admin'
    // activo) además del bootstrap legacy /admins. Antes solo /admins, lo que
    // bloqueaba subidas de admins dados de alta por el flujo nuevo.
    function isAdmin() {
      return isSignedIn() && (
        (hasProfile() && profile().rol == 'admin' && profile().activo == true) ||
        adminsBootstrapValido()
      );
    }

    // ── Documentos técnicos ──
    // Lectura solo para MIEMBRO ACTIVO del equipo: antes bastaba con estar
    // autenticado (ADR-052 Ola 0), lo que entregaba los documentos a
    // cualquier cuenta de Firebase Auth del proyecto — incluida una ya
    // desactivada. Ahora se exige el mismo criterio que Firestore
    // (`isTeamMember`). Los download-token URLs (getDownloadURL) siguen
    // funcionando; se cierra el acceso por-path.
    match /documentos/{docId}/{filename=**} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.size <= 20 * 1024 * 1024;
      allow update: if isAdmin()
                    && request.resource.size <= 20 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Información Contractual (Fase 3 · 2026-04-27) ──
    // PDFs por contrato: contratos/{contrato_id}/{filename}.pdf
    // Lectura solo para MIEMBRO ACTIVO del equipo: son documentos
    // contractuales reales — ni anónimos, ni "cualquier cuenta con sesión".
    match /contratos/{contratoId}/{filename=**} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.size <= 50 * 1024 * 1024;
      allow update: if isAdmin()
                    && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Pruebas Eléctricas (Mantenimiento Predictivo) ──
    // PDFs originales de cada informe:
    //   pruebas_electricas/{unidadId}/{filename}.pdf
    // Lectura solo para MIEMBRO ACTIVO del equipo: informes técnicos
    // reales de cliente (misma clase que 450108/, excluido del repo).
    match /pruebas_electricas/{unidadId}/{filename=**} {
      allow read:   if isTeamMember();
      allow create: if isAdmin()
                    && request.resource.size <= 50 * 1024 * 1024;
      allow update: if isAdmin()
                    && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Firmas personales (ADR-071) ──
    // `firmas/{uid}` — una por persona, y SOLO la suya. Es la única ruta del
    // bucket donde la lectura no basta con ser del equipo: se exige además
    // que el uid de la sesión sea el del archivo. Si un miembro activo
    // pudiera leer la firma de otro, el sitio serviría para estampar la
    // firma ajena en un documento, que es exactamente lo que se retiró del
    // repositorio público en ADR-070.
    //
    // Escritura: el propio dueño (no el admin). Una firma manuscrita es un
    // dato personalísimo; que un administrador pueda subirla por otro
    // rompería la única garantía que da este mecanismo.
    //   · solo PNG — es el formato que conserva el fondo transparente; un
    //     JPG llega con fondo blanco y tapa la línea de firma del formato.
    //   · 1 MB — un trazo recortado pesa decenas de KB; el tope corta las
    //     fotos de cámara sin recortar.
    // RETIRADO para escribir (ADR-100): la firma propia vive ahora en Firestore
    // `firmas/{uid}` porque Storage no entrega las descargas al navegador (503).
    // Queda leer y BORRAR la copia vieja, para limpiarla; nadie sube aquí.
    match /firmas/{uid} {
      allow read:   if isTeamMember() && request.auth.uid == uid;
      allow create, update: if false;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Firmas del EQUIPO bajo custodia (ADR-099) ──
    // Pedido del Ingeniero: el Excel de Fichas lleva la firma de todos. Cada
    // CUSTODIO (admin) guarda SU copia de las firmas que le autorizaron, en
    // firmas-equipo/{su uid}/{persona}: solo él la lee, la reemplaza o la quita.
    // Otro admin NO la ve (la autorización se dio a una persona, no a un rol).
    //   · persona: una de las 5 claves FIJAS de la lista (domain/firmas_equipo.js).
    //   · solo PNG ≤ 512 KB, con la declaración de la autorización del titular
    //     (fecha ISO + medio) y la huella SHA-256 de la imagen en sus metadatos.
    //   · `get` y no `read`: nadie LISTA el directorio.
    function personaDelEquipo(p) {
      return p in ['MIGUEL_JIMENEZ', 'CARLOS_MARTELO', 'JORGE_RHENALS', 'JORGE_MIRANDA', 'ERICK_VERGARA'];
    }
    // Custodio = admin CON PERFIL: el de arranque (/admins, sin perfil) no puede
    // dejar el registro, así que tampoco sube ni lee (revisión de §99.11).
    // RETIRADO para escribir (ADR-100): ahora en Firestore
    // `firmas_equipo/{custodio}/personas/{persona}`. Queda leer y borrar lo viejo.
    match /firmas-equipo/{custodio}/{persona} {
      allow get:    if hasProfile() && isAdmin() && request.auth.uid == custodio && personaDelEquipo(persona);
      allow create, update: if false;
      // Quitar la propia copia no exige seguir siendo admin: un custodio al que
      // le retiran el rol debe poder retirar lo que custodiaba.
      allow delete: if isSignedIn() && request.auth.uid == custodio;
    }

    // ── Informe de Mantenimiento Brigada · F60-ADM (TODO-81) ──
    // Fotos y anexos por informe; marca (logos), firmas de terceros (solo
    // editores las leen) y fichas de fabricante. Todo inmutable: reemplazar
    // = ruta nueva. Las versiones emitidas siguen apuntando a lo que usaron.
    // `resource == null` en cada create: lo que ya existe no se reescribe (el
    // emulador dejaba pasar una subida encima por la rama create).
    // `get` y no `read`: en Storage `read` incluye LISTAR, y nadie necesita
    // enumerar estas carpetas (ver «límites conocidos» de
    // tests-rules/storage.rules.test.js). Editores = lista de uid de
    // informes_brigada_config/general en Firestore (nunca nombres).
    // TOPE DE STORAGE: una evaluación lee como máximo DOS documentos de
    // Firestore (firebase.google.com/docs/storage/security/rules-conditions).
    // ibrEditor ya lee dos (usuarios/{uid} y la configuración): NINGUNA regla
    // de este bloque puede leer un tercero (p. ej. el informe) — el emulador no
    // aplica el tope y en producción fallaría. Lo cuida una prueba estática
    // (tests/informe_brigada_datos_estatico.test.js). Por eso las fotos no miran
    // el estado del informe: son inmutables y nadie las borra desde el
    // navegador; lo emitido queda congelado en Firestore (versiones/{n}).
    function ibrEditor() {
      return hasProfile() && profile().activo == true
        && request.auth.uid in firestore.get(/databases/(default)/documents/informes_brigada_config/general).data.editores;
    }
    function ibrHuella(h) { return h is string && h.matches('^[0-9a-f]{64}$'); }

    match /informes_brigada/{informeId}/archivos/{archivoId} {
      allow get: if isTeamMember();
      allow create: if resource == null && ibrEditor()
        && archivoId.matches('^a[A-Za-z0-9]{20}$')
        && request.resource.size >= 1 && request.resource.size <= 700 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png)$')
        && ibrHuella(request.resource.metadata.huella);
      allow update, delete: if false;
    }
    match /informes_brigada_marca/logos/{clave}/{huella} {
      allow get: if isTeamMember();
      allow create: if resource == null && hasProfile() && isAdmin()
        && clave in ['applus-encabezado', 'together-encabezado', 'applus-portada', 'together-portada', 'afinia-portada']
        && ibrHuella(huella) && request.resource.metadata.huella == huella
        && request.resource.size >= 1 && request.resource.size <= 1024 * 1024
        && request.resource.contentType.matches('^image/(png|jpeg)$');
      // Nadie borra un logo: las versiones emitidas lo siguen usando (reemplazar = huella nueva).
      allow update, delete: if false;
    }
    match /informes_brigada_marca/firmas/{clave}/{huella} {
      allow get: if ibrEditor();
      allow create: if resource == null && hasProfile() && isAdmin()
        && clave.matches('^[a-z0-9-]{2,40}$')
        && ibrHuella(huella) && request.resource.metadata.huella == huella
        && request.resource.size >= 1 && request.resource.size <= 512 * 1024
        && request.resource.contentType == 'image/png'
        && request.resource.metadata.autorizacion_fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.metadata.autorizacion_medio.size() >= 3;
      allow update: if false;
      allow delete: if hasProfile() && isAdmin();
    }
    match /informes_brigada_marca/fichas/{fichaId} {
      allow get: if isTeamMember();
      allow create: if resource == null && ibrEditor()
        && fichaId.matches('^[a-z0-9_-]{3,80}$')
        && request.resource.size >= 1 && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('^image/(png|jpeg)$')
        && ibrHuella(request.resource.metadata.huella);
      // Nadie borra una ficha: las versiones emitidas la siguen usando.
      allow update, delete: if false;
    }

    // ── Resto: cerrado por defecto ──
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
