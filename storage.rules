rules_version = '2';

// ══════════════════════════════════════════════════════════════
// SGM · TRANSPOWER — Reglas Firebase Storage (Fase 9)
// Gestión documental:
//   documentos/{docId}/{filename=**}  → lectura pública
//   (filtrada por gate estático), escritura restringida a admins
//   registrados en /admins/{uid} con tope de 20 MB por archivo.
// ══════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helpers ──
    function isSignedIn() {
      return request.auth != null;
    }
    // G005 (ADR-052 Ola 1): reconoce a los admins v2 (/usuarios rol='admin'
    // activo) además del bootstrap legacy /admins. Antes solo /admins, lo que
    // bloqueaba subidas de admins dados de alta por el flujo nuevo.
    function isAdmin() {
      return isSignedIn() && (
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        || (
          firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin'
          && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.activo == true
        )
      );
    }

    // ── Documentos técnicos ──
    // Lectura solo para usuarios autenticados (ADR-052 Ola 0): antes era
    // pública anónima. Los download-token URLs (getDownloadURL) siguen
    // funcionando; se cierra el acceso por-path sin sesión.
    match /documentos/{docId}/{filename=**} {
      allow read:   if isSignedIn();
      allow create: if isAdmin()
                    && request.resource.size <= 20 * 1024 * 1024;
      allow update: if isAdmin()
                    && request.resource.size <= 20 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Información Contractual (Fase 3 · 2026-04-27) ──
    // PDFs por contrato: contratos/{contrato_id}/{filename}.pdf
    // Lectura solo autenticados (ADR-052 Ola 0): son documentos
    // contractuales reales de AFINIA — NO deben ser anónimos.
    match /contratos/{contratoId}/{filename=**} {
      allow read:   if isSignedIn();
      allow create: if isAdmin()
                    && request.resource.size <= 50 * 1024 * 1024;
      allow update: if isAdmin()
                    && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Pruebas Eléctricas (Mantenimiento Predictivo) ──
    // PDFs originales de cada informe:
    //   pruebas_electricas/{unidadId}/{filename}.pdf
    // Lectura solo autenticados (ADR-052 Ola 0): informes técnicos
    // reales de cliente (misma clase que 450108/, excluido del repo).
    match /pruebas_electricas/{unidadId}/{filename=**} {
      allow read:   if isSignedIn();
      allow create: if isAdmin()
                    && request.resource.size <= 50 * 1024 * 1024;
      allow update: if isAdmin()
                    && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Resto: cerrado por defecto ──
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
