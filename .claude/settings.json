{
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -rF *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(rm -f -r *)",
      "Bash(rm -r -f *)",
      "Bash(rm --recursive *)",
      "Bash(sudo *)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git * --no-verify*)",
      "Bash(git * --no-gpg-sign*)",
      "Bash(git config core.hooksPath *)",
      "Bash(git config * core.hooksPath *)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git reflog expire*)",
      "Bash(git stash clear*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit * --visibility*)",
      "Bash(gh auth token*)",
      "Bash(git -C * config core.hooksPath *)",
      "Bash(git -C * config * core.hooksPath *)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * clean*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/boveda.mjs\" brain-check --boot --si-falta=callar",
            "timeout": 30,
            "statusMessage": "Auto-auditoría del cerebro (en la bóveda)…"
          },
          {
            "type": "command",
            "command": "node \"$HOME/Proyectos/brain-private/kernel/session-handoff.mjs\" --boot-echo --root \"$HOME/Proyectos/brain-private/sgm-transpower\" --sitio \"$CLAUDE_PROJECT_DIR\" || node \"$CLAUDE_PROJECT_DIR/scripts/boveda.mjs\" session-handoff --boot-echo --si-falta=avisar",
            "timeout": 15,
            "statusMessage": "Cerebro en la bóveda + handoff…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/boveda.mjs\" session-handoff --tick --si-falta=callar",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/boveda.mjs\" session-handoff --tick --si-falta=callar",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/boveda.mjs\" session-handoff --precompact --si-falta=callar",
            "timeout": 15,
            "statusMessage": "Caja negra: volcando foto de sesión…"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/boveda.mjs\" session-handoff --end --si-falta=callar",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/boveda.mjs\" session-handoff --end --si-falta=callar",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}
